{
  "name": "emela",
  "displayName": "Emela",
  "description": "Emela language support: diagnostics, completion and the other features of `emela lsp`, plus syntax highlighting.",
  "version": "0.25.0",
  "publisher": "Emela",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/emela-lang/emela.git",
    "directory": "editors/vscode"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "main": "./out/extension.js",
  "activationEvents": [],
  "contributes": {
    "languages": [
      {
        "id": "emela",
        "aliases": [
          "Emela"
        ],
        "extensions": [
          ".emel"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "emela",
        "scopeName": "source.emela",
        "path": "./syntaxes/emela.tmLanguage.json"
      }
    ],
    "commands": [
      {
        "command": "emela.restartServer",
        "title": "Restart Language Server",
        "category": "Emela"
      }
    ],
    "configuration": {
      "title": "Emela",
      "properties": {
        "emela.serverPath": {
          "type": "string",
          "default": "emela",
          "description": "Path to the `emela` binary that provides the language server (`emela lsp`). A bare name is looked up on `PATH` and then in `~/.emela/bin`. Changing it restarts the server."
        }
      }
    }
  },
  "scripts": {
    "check": "tsc -p ./ --noEmit",
    "compile": "npm run check && node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "package": "vsce package",
    "vscode:prepublish": "npm run check && node esbuild.mjs --production"
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "4.1.0",
    "esbuild": "^0.25.12",
    "typescript": "^5.4.0"
  }
}
