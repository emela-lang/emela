{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Emela",
  "scopeName": "source.emela",
  "patterns": [{ "include": "#code" }],
  "repository": {
    "code": {
      "patterns": [
        { "include": "#comments" },
        { "include": "#strings" },
        { "include": "#numbers" },
        { "include": "#annotations" },
        { "include": "#imports" },
        { "include": "#declarations" },
        { "include": "#keywords" },
        { "include": "#types" },
        { "include": "#functions" },
        { "include": "#operators" },
        { "include": "#punctuation" }
      ]
    },
    "comments": {
      "patterns": [
        {
          "match": "##.*$",
          "name": "comment.line.documentation.emela"
        },
        {
          "match": "#(?!\\{).*$",
          "name": "comment.line.number-sign.emela"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "begin": "\"\"\"",
          "end": "\"\"\"",
          "beginCaptures": { "0": { "name": "punctuation.definition.string.begin.emela" } },
          "endCaptures": { "0": { "name": "punctuation.definition.string.end.emela" } },
          "name": "string.quoted.triple.emela",
          "patterns": [{ "include": "#string-contents" }]
        },
        {
          "begin": "\"",
          "end": "\"|$",
          "beginCaptures": { "0": { "name": "punctuation.definition.string.begin.emela" } },
          "endCaptures": { "0": { "name": "punctuation.definition.string.end.emela" } },
          "name": "string.quoted.double.emela",
          "patterns": [{ "include": "#string-contents" }]
        }
      ]
    },
    "string-contents": {
      "patterns": [
        {
          "match": "\\\\(u\\{[0-9a-fA-F]{1,6}\\}|[\"\\\\ntr#])",
          "name": "constant.character.escape.emela"
        },
        {
          "match": "\\\\.",
          "name": "invalid.illegal.escape.emela"
        },
        {
          "begin": "#\\{",
          "end": "\\}",
          "beginCaptures": { "0": { "name": "punctuation.section.interpolation.begin.emela" } },
          "endCaptures": { "0": { "name": "punctuation.section.interpolation.end.emela" } },
          "name": "meta.interpolation.emela",
          "contentName": "source.emela.embedded",
          "patterns": [{ "include": "#interpolation-code" }]
        }
      ]
    },
    "interpolation-code": {
      "comment": "Braces nest inside an interpolation, so `#{ {a} }` ends at the outer `}`.",
      "patterns": [
        {
          "begin": "\\{",
          "end": "\\}",
          "patterns": [{ "include": "#interpolation-code" }]
        },
        { "include": "#code" }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "match": "\\b[0-9][0-9_]*\\.[0-9][0-9_]*([eE][+-]?[0-9][0-9_]*)?\\b",
          "name": "constant.numeric.float.emela"
        },
        {
          "match": "\\b0x[0-9a-fA-F][0-9a-fA-F_]*\\b",
          "name": "constant.numeric.hex.emela"
        },
        {
          "match": "\\b0b[01][01_]*\\b",
          "name": "constant.numeric.binary.emela"
        },
        {
          "match": "\\b[0-9][0-9_]*\\b",
          "name": "constant.numeric.integer.emela"
        }
      ]
    },
    "annotations": {
      "comment": "`@export(js, \"default\", \"fetch\")`, `@entry(Http.serve)`, `@test`.",
      "patterns": [
        {
          "begin": "(@)([a-z_][A-Za-z0-9_]*)\\s*(\\()",
          "end": "\\)",
          "beginCaptures": {
            "1": { "name": "punctuation.definition.annotation.emela" },
            "2": { "name": "storage.type.annotation.emela" },
            "3": { "name": "punctuation.section.arguments.begin.emela" }
          },
          "endCaptures": { "0": { "name": "punctuation.section.arguments.end.emela" } },
          "name": "meta.annotation.emela",
          "patterns": [
            { "include": "#comments" },
            { "include": "#strings" },
            { "include": "#numbers" },
            {
              "match": "\\b((?:[A-Z][A-Za-z0-9]*\\.)+)([a-z_][A-Za-z0-9_]*)\\b",
              "captures": {
                "1": { "name": "entity.name.namespace.emela" },
                "2": { "name": "entity.name.function.emela" }
              }
            },
            {
              "match": "\\b([a-z_][A-Za-z0-9_]*)\\s*(:)",
              "captures": {
                "1": { "name": "variable.parameter.emela" },
                "2": { "name": "punctuation.separator.key-value.emela" }
              }
            },
            {
              "match": "\\b[a-z_][A-Za-z0-9_]*\\b",
              "name": "constant.other.emela"
            },
            { "include": "#punctuation" }
          ]
        },
        {
          "match": "(@)([a-z_][A-Za-z0-9_]*)",
          "name": "meta.annotation.emela",
          "captures": {
            "1": { "name": "punctuation.definition.annotation.emela" },
            "2": { "name": "storage.type.annotation.emela" }
          }
        }
      ]
    },
    "imports": {
      "comment": "`import Http.Client.{get, Response}`: the type names of the path are modules.",
      "begin": "\\b(import)\\b",
      "end": "$|(?=#)",
      "beginCaptures": { "1": { "name": "keyword.control.import.emela" } },
      "name": "meta.import.emela",
      "patterns": [
        {
          "begin": "\\{",
          "end": "\\}",
          "patterns": [
            {
              "match": "\\b[A-Z][A-Z0-9_]*\\b(?![a-z])",
              "name": "variable.other.constant.emela"
            },
            { "match": "\\b[A-Z][A-Za-z0-9]*\\b", "name": "entity.name.type.emela" },
            { "match": "\\b[a-z_][A-Za-z0-9_]*\\b", "name": "entity.name.function.emela" },
            { "include": "#punctuation" }
          ]
        },
        { "match": "\\b[A-Z][A-Za-z0-9]*\\b", "name": "entity.name.namespace.emela" },
        { "include": "#punctuation" }
      ]
    },
    "declarations": {
      "patterns": [
        {
          "match": "\\b(fn)\\s+([a-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": { "name": "storage.type.function.emela" },
            "2": { "name": "entity.name.function.emela" }
          }
        },
        {
          "match": "\\b(type|enum|error|effect|handler|layer|trait)\\s+([A-Z][A-Za-z0-9]*)",
          "captures": {
            "1": { "name": "storage.type.emela" },
            "2": { "name": "entity.name.type.emela" }
          }
        },
        {
          "match": "\\b(const)\\s+([A-Z][A-Z0-9_]*)\\b",
          "captures": {
            "1": { "name": "storage.type.emela" },
            "2": { "name": "variable.other.constant.emela" }
          }
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "match": "\\b(if|else|match)\\b",
          "name": "keyword.control.conditional.emela"
        },
        {
          "match": "\\b(fail|escape)\\b",
          "name": "keyword.control.exception.emela"
        },
        {
          "match": "\\b(fn)\\b",
          "name": "storage.type.function.emela"
        },
        {
          "match": "\\b(type|enum|error|effect|handler|layer|trait|const)\\b",
          "name": "storage.type.emela"
        },
        {
          "match": "\\b(pub|opaque|suspend)\\b",
          "name": "storage.modifier.emela"
        },
        {
          "match": "\\b(impl|use|with|assert)\\b",
          "name": "keyword.other.emela"
        },
        {
          "comment": "Contextual keywords ([kw.contextual]). Outside their positions they are identifiers, which this grammar cannot tell apart, so only the forms that are rarely identifiers are matched.",
          "match": "\\b(fails|derive)\\b|(?:^|(?<=\\{))\\s*\\b(init|release)\\b(?=\\s*[({])|\\b(of|by)\\b(?=\\s+[A-Z])",
          "name": "keyword.other.emela"
        },
        {
          "match": "\\b(default)\\s*$",
          "name": "keyword.other.emela"
        },
        {
          "match": "\\b(self)\\b",
          "name": "variable.language.self.emela"
        },
        {
          "match": "\\b(Self)\\b",
          "name": "storage.type.self.emela"
        },
        {
          "comment": "Reserved words without syntax ([kw.reserved], [kw.future]).",
          "match": "\\b(as|var|return|while|loop|let|mut|in|where|do|try|catch|throw|async|yield|defer|macro|mod)\\b",
          "name": "invalid.illegal.reserved.emela"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "match": "\\b(True|False)\\b",
          "name": "constant.language.boolean.emela"
        },
        {
          "comment": "`List.map`, `Http.Client.get`: a type name on the left of `.` is a module.",
          "match": "\\b[A-Z][A-Za-z0-9]*(?=\\.[A-Za-z_])",
          "name": "entity.name.namespace.emela"
        },
        {
          "match": "\\b(Int|Int64|Float|Bool|String|Unit|List|Option|Result)\\b",
          "name": "support.type.builtin.emela"
        },
        {
          "comment": "An uppercase name ([lex.name]): a const or a type parameter.",
          "match": "\\b[A-Z][A-Z0-9_]*\\b(?![a-z])",
          "name": "variable.other.constant.emela"
        },
        {
          "match": "\\b[A-Z][A-Za-z0-9]*\\b",
          "name": "entity.name.type.emela"
        }
      ]
    },
    "functions": {
      "patterns": [
        {
          "comment": "`xs |> List.reverse`, `x |> dbg`",
          "match": "(?<=\\|>)\\s*([a-z_][A-Za-z0-9_]*)\\b(?!\\s*\\.)",
          "captures": { "1": { "name": "entity.name.function.emela" } }
        },
        {
          "match": "\\b[a-z_][A-Za-z0-9_]*(?=\\()",
          "name": "entity.name.function.emela"
        },
        {
          "match": "\\b([a-z_][A-Za-z0-9_]*)\\s*(:)(?!:)",
          "captures": {
            "1": { "name": "variable.parameter.emela" }
          }
        }
      ]
    },
    "operators": {
      "patterns": [
        { "match": "->", "name": "keyword.operator.arrow.emela" },
        { "match": "\\|>", "name": "keyword.operator.pipe.emela" },
        { "match": "\\.\\.", "name": "keyword.operator.spread.emela" },
        { "match": "&&|\\|\\||!(?!=)", "name": "keyword.operator.logical.emela" },
        { "match": "==|!=|<=|>=|<|>", "name": "keyword.operator.comparison.emela" },
        { "match": "=", "name": "keyword.operator.assignment.emela" },
        { "match": "[+\\-*/%]", "name": "keyword.operator.arithmetic.emela" },
        { "match": "\\|", "name": "keyword.operator.union.emela" }
      ]
    },
    "punctuation": {
      "patterns": [
        { "match": ",", "name": "punctuation.separator.comma.emela" },
        { "match": "\\.", "name": "punctuation.accessor.emela" },
        { "match": ":", "name": "punctuation.separator.colon.emela" }
      ]
    }
  }
}
