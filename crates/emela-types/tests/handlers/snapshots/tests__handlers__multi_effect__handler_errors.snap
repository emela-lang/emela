---
source: crates/emela-types/tests/handlers/multi_effect.rs
expression: "run(r#\"\neffect Reader {\n  fn query(sql: String) -> Int\n}\n\nhandler Missing: Query + Execute + Audit {\n  fn execute(sql) { () }\n}\n\nhandler Twice: Query + Execute {\n  fn query(sql) { 0 }\n  fn execute(sql) { () }\n  fn execute(sql) { () }\n}\n\nhandler Clash: Query + Reader {\n  fn query(sql) { 0 }\n}\n\nhandler Repeated: Audit + Query + Audit {\n  fn note(msg) { () }\n  fn query(sql) { 0 }\n}\n\nhandler Arity: Query + Execute {\n  fn query(sql) { 0 }\n  fn execute() { () }\n}\n\neffect Replica of Query\n\nhandler OfLabel: Replica + Audit {\n  fn note(msg) { () }\n}\n\nhandler WithAsync: Audit + Async {\n  fn note(msg) { () }\n}\n\"#)"
---
`Missing` MissingHandlerOps { handler: "Missing", ops: ["query", "note"], members: [] }
`execute` DuplicateHandlerOp { op: "execute" }
`Reader` SharedOperationName { handler: "Clash", op: "query", first: "Query", second: "Reader" }
`Audit` RepeatedHandlerEffect { handler: "Repeated", effect: "Audit" }
`execute` HandlerOpArgCount { op: "execute", expected: 1, found: 0 }
`OfLabel` HandlerOfLabel { handler: "OfLabel", label: "Replica", base: "Query" }
`WithAsync` HostEffectHandler { handler: "WithAsync", effect: "Async" }
