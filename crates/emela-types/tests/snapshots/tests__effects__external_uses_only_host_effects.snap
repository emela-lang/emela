---
with_marker: fn() -> () uses { Marker }
with_async: fn() -> () uses { Async }
with_set: ∀ R, E(f). fn(fn() -> () fails E(f) uses { R }) -> () fails E(f) uses { R }
with_host: fn() -> () uses { ProcessHost, PageHost }
pure: fn() -> ()
`Marker` ExternalUses { function: "with_marker" }
`Async` ExternalUses { function: "with_async" }
`fn() -> () uses { R }` NotImmediate { effects: [], sets: ["R"], required: ExternalCallback { callee: "with_set" } }
`R` ExternalUses { function: "with_set" }
