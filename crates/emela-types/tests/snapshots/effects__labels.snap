---
source: crates/emela-types/tests/effects.rs
expression: "render_handlers(r#\"\neffect Log {\n  fn log(msg: String) -> ()\n}\n\neffect Clock {\n  suspend fn sleep(ms: Int) -> ()\n}\n\neffect Audit of Log\neffect Debug of Log default\neffect Other of Log\neffect Ticks of Clock\n\nhandler PrintLog: Log {\n  fn log(msg) { () }\n}\n\nhandler Tagged: Log {\n  fn log(msg) { (use Other).log(msg) }\n}\n\nfn a() { (use Log).log(\"a\") }\n\nfn c() {\n  with Audit { a() }\n  with Debug { a() }\n}\n\nfn direct() { (use Audit).log(\"x\") }\n\nfn run_hidden(f: fn() -> ()) { with PrintLog { f() } }\n\nfn main() {\n  with PrintLog, Audit by Log { c() }\n  with PrintLog, Audit by PrintLog, Debug by Tagged, Other by Log { c() }\n  with Audit by PrintLog { direct() }\n  with PrintLog, Audit by Log { with Other by Audit { run_hidden(fn() { (use Other).log(\"y\") }) } }\n}\n\nfn ticks[R: Immediate](f: fn() -> () use R) { f() }\n\nfn sleeps() { ticks(fn() { (use Ticks).sleep(1) }) }\n\"#)"
---
a: fn() -> () use Log
c: fn() -> () use { Audit, Debug }
direct: fn() -> () use Audit
run_hidden: ∀ E(f), R(f). fn(fn() -> () fails E(f) use R(f)) -> () fails E(f) use R(f)
main: fn() -> ()
ticks: ∀ R: Immediate, E(f). fn(fn() -> () fails E(f) use R) -> () fails E(f) use R
sleeps: fn() -> () use Ticks
handler PrintLog: use {}
handler Tagged: use Other
with Audit: init [Log <- Audit]
with Debug: init [Log <- Debug]
with PrintLog: init [PrintLog]
with PrintLog, Audit by Log: init [PrintLog, Audit <- Log] Debug from 0
with PrintLog, Audit by PrintLog, Debug by Tagged, Other by Log: init [PrintLog, Audit by PrintLog, Other <- Log, Debug by Tagged]
with Audit by PrintLog: init [Audit by PrintLog]
with PrintLog, Audit by Log: init [PrintLog, Audit <- Log]
with Other by Audit: init [Other <- Audit]
`ticks` NotImmediate { effects: ["Ticks"], sets: [], required: Bound { param: "R", callee: "ticks" } }
