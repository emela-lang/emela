---
source: crates/emela-types/tests/spec_examples.rs
expression: "render_bodies(r#\"\ntype Instant(ms: Int)  # 補\n\neffect Clock {\n  suspend fn sleep(ms: Int) -> ()\n  fn now() -> Instant\n}\n\n@external(js, \"setTimeout\")  # 補\nfn set_timeout(ms: Int, f: fn() -> ()) -> ()\n\n@external(js, \"Date.now\")  # 補\nfn date_now() -> Instant\n\nhandler JsClock: Clock {\n  suspend fn sleep(ms, resume) {\n    set_timeout(ms, fn() { resume(()) })\n  }\n  fn now() { date_now() }\n}\n\nhandler InstantClock: Clock {  # 補\n  suspend fn sleep(ms, resume) { resume(()) }\n  fn now() { Instant(ms: 0) }\n}\n\nfn nap() {  # 補\n  (use Clock).sleep(1000)\n  (use Clock).now()\n}\n\nfn real() { with JsClock { nap() } }  # 補\n\nfn instant() { with InstantClock { nap() } }  # 補\n\"#)"
---
set_timeout: ∀ E(f), R(f): Immediate. fn(Int, fn() -> () fails E(f) use R(f)) -> () fails E(f) use R(f)
date_now: fn() -> Instant
nap: fn() -> Instant use Clock
real: fn() -> Instant use Async
instant: fn() -> Instant
