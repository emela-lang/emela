expression: "render(r#\"\nimport Std.Fiber.{Fiber, Scope}\n\ntype User(name: String)\n\neffect Users {\n  fn find(id: Int) -> User\n}\n\nhandler PostgresUsers: Users {\n  fn find(id) { User(name: \"alice\") }\n}\n\nfn main() {\n  Fiber.scope(|| {\n    s = use Scope\n    with PostgresUsers {\n      s.fork(|| (use Users).find(1))\n    }\n    ()\n  })\n}\n\nfn fixed() -> () use { Async } {\n  with PostgresUsers {\n    Fiber.scope(|| {\n      Fiber.fork(|| (use Users).find(1))\n      ()\n    })\n  }\n}\n\nfn body_itself() -> () use { Async } {\n  Fiber.scope(|| {\n    (use Users).find(1)\n    ()\n  })\n}\n\nfn test_forked() {\n  Fiber.scope(|| {\n    Fiber.fork(|| (use Users).find(1))\n    ()\n  })\n}\n\"#)"
