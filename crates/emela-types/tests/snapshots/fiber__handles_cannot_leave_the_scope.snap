`Fiber.scope(|| Fiber.semaphore(2))` EscapingFromScope { ty: "Semaphore", scope: "Fiber.scope" }
`Fiber.scope(|| {
    q: Queue[Int] = Fiber.queue(1)
    [q]
  })` EscapingFromScope { ty: "Queue", scope: "Fiber.scope" }
