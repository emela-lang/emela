---
source: crates/emela-types/tests/effects.rs
expression: "render_handlers(r#\"\nerror DbDown\n\ntype Connection(url: String)\n\neffect Config {\n  fn db_url() -> String\n}\n\neffect Users {\n  fn find(id: Int) -> String\n}\n\neffect Logger {\n  fn info(msg: String) -> ()\n}\n\neffect Clock {\n  suspend fn sleep(ms: Int) -> ()\n}\n\nfn connect(url: String) -> Connection fails DbDown {\n  if url == \"\" { fail DbDown } else { Connection(url:) }\n}\n\nhandler PostgresUsers(conn: Connection): Users {\n  init {\n    config = use Config\n    PostgresUsers(conn: connect(config.db_url()))\n  }\n\n  release {\n    (use Logger).info(self.conn.url)\n    (use Clock).sleep(10)\n  }\n\n  fn find(id) { self.conn.url }\n}\n\nhandler EnvConfig: Config {\n  fn db_url() { \"postgres://\" }\n}\n\nhandler Quiet: Logger {\n  init { Quiet }\n  release { () }\n  fn info(msg) { () }\n}\n\nhandler Unit(): Logger {\n  init { Unit() }\n  fn info(msg) { () }\n}\n\nfn lookup() {\n  with EnvConfig, PostgresUsers { (use Users).find(1) }\n}\n\nfn reversed() {\n  with PostgresUsers, EnvConfig { (use Users).find(1) }\n}\n\nfn logged() {\n  with Quiet, EnvConfig, PostgresUsers { (use Users).find(1) }\n}\n\"#)"
---
connect: fn(String) -> Connection fails DbDown
lookup: fn() -> String fails DbDown use { Logger, Clock }
reversed: fn() -> String fails DbDown use { Logger, Clock }
logged: fn() -> String fails DbDown use Clock
handler PostgresUsers: use { Config, Logger, Clock }
handler EnvConfig: use {}
handler Quiet: use {}
handler Unit: use {}
