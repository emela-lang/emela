source: crates/emela-types/tests/spec_examples.rs
expression: "render_bodies(r#\"\neffect Quiet {  # 補\n  fn hush() -> ()\n}\n\neffect Logger {  # 補\n  fn info(msg: String) -> ()\n}\n\nhandler QuietHandler implements Quiet {  # 補\n  fn hush() { () }\n}\n\nfn run_hidden(f: fn() -> ()) { with QuietHandler { f() } }  # 補．仕様の `run(f: fn() -> ())`\n\nfn run[R](f: fn() -> () use { Quiet, R }) -> () use R {\n  with QuietHandler { f() }      # R は R だけ。Quiet は消える\n}\n\nfn callers() {  # 補\n  a = run(fn() {\n    (use Quiet).hush()\n    (use Logger).info(\"x\")\n  })\n  b = run_hidden(fn() { (use Quiet).hush() })\n}\n\"#)"
---
run_hidden: ∀ E(f), R(f). fn(fn() -> () fails E(f) use R(f)) -> () fails E(f) use R(f)
  f: fn() -> () fails '0 use '1
run: ∀ R, E(f). fn(fn() -> () fails E(f) use { Quiet, R }) -> () fails E(f) use R
