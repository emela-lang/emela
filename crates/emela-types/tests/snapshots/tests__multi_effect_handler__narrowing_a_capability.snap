---
source: crates/emela-types/tests/multi_effect_handler.rs
expression: "run(r#\"\nhandler Everything: Query + Execute + Audit {\n  fn query(sql) { 0 }\n  fn execute(sql) { () }\n  fn note(msg) { () }\n}\n\nfn read_only(q: use Query) -> Int { q.query(\"a\") }\n\nfn read_write(rw: use Query + Execute) -> Int {\n  rw.execute(\"b\")\n  read_only(rw)\n}\n\nfn audited(c: use Audit + Query + Execute) -> Int {\n  c.note(\"c\")\n  read_write(c) + read_only(c)\n}\n\nfn all() -> Int {\n  with e = Everything { audited(e) }\n}\n\"#)"
---
read_only: ∀ C(q). fn(use Query) -> Int uses { q }
  q: use Query
read_write: ∀ C(rw). fn(use Query + Execute) -> Int uses { rw }
  rw: use Query + Execute
audited: ∀ C(c). fn(use Query + Execute + Audit) -> Int uses { c }
  c: use Query + Execute + Audit
all: fn() -> Int
  e: use Query + Execute + Audit
