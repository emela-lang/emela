---
source: crates/emela-types/tests/fiber.rs
expression: "render(r#\"\nimport Std.Fiber.{Fiber, Exit, Success, Failure}\nimport Std.Cause.{Cause, CauseKind, Fail, Die, Interrupt}\n\nerror Boom\n\neffect Log {\n  fn info(msg: String) -> ()\n}\n\nfn boom() -> Int fails Boom { fail Boom }\n\nfn guarded() -> () uses { Log } {\n  Fiber.attempt(fn() { boom() }) match {\n    Success(_) -> ()\n    Failure(cause) -> (use Log).info(Cause.to_string(cause))\n  }\n}\n\nfn reraise() {\n  Fiber.attempt(fn() { boom() }) match {\n    Success(n) -> n\n    Failure(cause) -> Cause.raise(cause)\n  }\n}\n\nfn recovered() {\n  reraise() escape {\n    Boom -> 0\n  }\n}\n\nfn kinds(c: Cause[Boom]) -> Bool {\n  Cause.kind(c) match {\n    Fail -> True\n    Die -> False\n    Interrupt -> False\n  }\n}\n\nfn watched() {\n  Fiber.scope(fn() {\n    child = Fiber.fork(fn() { 1 })\n    Fiber.interrupt(child)\n    Fiber.await(child) match {\n      Success(n) -> n\n      Failure(_) -> 0\n    }\n  })\n}\n\"#)"
---
boom: fn() -> Int fails Boom
guarded: fn() -> () uses { Log }
  cause: Cause[Boom]
reraise: fn() -> Int fails Boom
  n: Int
  cause: Cause[Boom]
recovered: fn() -> Int
kinds: fn(Cause[Boom]) -> Bool
  c: Cause[Boom]
watched: fn() -> Int uses { Async }
  child: Fiber[Int]
  n: Int
