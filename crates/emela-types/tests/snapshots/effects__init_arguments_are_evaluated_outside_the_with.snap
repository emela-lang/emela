label: fn() -> String use Config
main: fn() -> String
handler EnvConfig: use {}
handler RemoteKv: use {}
handler FakeKv: use {}
with EnvConfig, RemoteKv(url: (use Config).url()): init [EnvConfig, RemoteKv]
with RemoteKv(url: (use Config).url()), FakeKv: init [FakeKv]
with AuditKv by RemoteKv(url: (use Config).url()): init [AuditKv by RemoteKv]
with EnvConfig: init [EnvConfig]
with EnvConfig, RemoteKv((use Config).url()): init [EnvConfig, RemoteKv]
