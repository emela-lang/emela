tried_n: fn(Semaphore) -> Option[Int]
  s: Semaphore
counted: fn(Semaphore) -> Int
  s: Semaphore
run: fn(List[Job]) -> () fails QueueClosed uses { Async }
  jobs: List[Job]
  q: Queue[Job]
  job: Job
work: fn(Queue[Job]) -> () uses { Async }
  q: Queue[Job]
  next: Option[Job]
  job: Job
