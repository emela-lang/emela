  q: Queue[Job]
others: fn(Queue[Job]) -> (Bool, Option[Job], Int)
  q: Queue[Job]
query: fn(String) -> List[String]
  sql: String
spec_11_9: fn(String) -> List[String] uses { Async }
  sql: String
  db: Semaphore
  rows: List[String]
spec_11_10: fn(Job) -> Job fails QueueClosed uses { Async }
  job: Job
  q: Queue[Job]
  taken: Job
