source: crates/emela-types/tests/capabilities.rs
expression: "run(r#\"\nfn tell(l: use Logger) { l.info(\"x\") }\n\nfn pick(a: use Logger, b: use Logger, first: Bool) -> use Logger {\n  if first { a } else { b }\n}\n\nfn declared(l: use Logger) -> () uses {} { l.info(\"y\") }\n\nfn main() {\n  with a = Quiet {\n    with b = Loud {\n      tell(b)\n      pick(a, b, True).info(\"z\")\n      declared(a)\n    }\n  }\n}\n\"#)"
