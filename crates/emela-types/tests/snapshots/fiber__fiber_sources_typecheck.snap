---
source: crates/emela-types/tests/fiber.rs
expression: out
---
kind: ∀ E. fn(Cause[E]) -> CauseKind
to_string: ∀ E. fn(Cause[E]) -> String
raise: ∀ A, E. fn(Cause[E]) -> A fails E
complete: ∀ A. fn(Deferred[A], A) -> Bool
await: ∀ A. fn(Deferred[A]) -> A use Async
poll: ∀ A. fn(Deferred[A]) -> Option[A]
fork: ∀ E, R, A. fn(fn() -> A fails E use { Scope[E, R], R }) -> Fiber[A]
deferred: ∀ E, R, A. fn() -> Deferred[A]
scope: ∀ A, E, R. fn(fn() -> A fails E use { Async, Scope[E, R], R }) -> A fails E use { Async, R }
fork: ∀ A, E, R. fn(fn() -> A fails E use { Scope[E, R], R }) -> Fiber[A] use Scope[E, R]
deferred: ∀ A, E, R. fn() -> Deferred[A] use Scope[E, R]
join: ∀ A. fn(Fiber[A]) -> A use Async
await: ∀ A. fn(Fiber[A]) -> Exit[A, {}] use Async
interrupt: ∀ A. fn(Fiber[A]) -> () use Async
attempt: ∀ A, E, R. fn(fn() -> A fails E use R) -> Exit[A, E] use R
all: ∀ A, E, R. fn(List[fn() -> A fails E use R]) -> List[A] fails E use { Async, R }
race: ∀ A, E, R. fn(List[fn() -> A fails E use R]) -> A fails E use { Async, R }
both: ∀ A, B, E, R. fn(fn() -> A fails E use R, fn() -> B fails E use R) -> (A, B) fails E use { Async, R }
map: ∀ A, B, E, R. fn(List[A], fn(A) -> B fails E use R) -> List[B] fails E use { Async, R }
