source: crates/emela-types/tests/spec_examples.rs
expression: "render_bodies(r#\"\ntype Rows(n: Int)  # 補\n\neffect Db {  # 補\n  fn query(q: String) -> Rows\n  fn execute(rows: Rows) -> ()\n}\n\nhandler PrimaryDb: Db {  # 補\n  fn query(q) { Rows(n: 0) }\n  fn execute(rows) { () }\n}\n\nhandler ReplicaDb: Db {  # 補\n  fn query(q) { Rows(n: 1) }\n  fn execute(rows) { () }\n}\n\nfn copy(read: fn() -> Rows uses { Db }, write: fn(Rows) -> () uses { Db }) {\n  write(read())\n}\n\nfn main() {  # 補\n  with PrimaryDb {\n    primary = use Db\n    with ReplicaDb {\n      replica = use Db\n      copy(fn() { replica.query(\"...\") }, fn(rows) { primary.execute(rows) })\n    }\n  }\n}\n\"#)"
---
copy: ∀ E(read), E(write). fn(fn() -> Rows fails E(read) uses { Db }, fn(Rows) -> () fails E(write) uses { Db }) -> () fails E(read) | E(write) uses { Db }
  read: fn() -> Rows fails '0 uses { Db }
  write: fn(Rows) -> () fails '1 uses { Db }
main: fn() -> ()
  primary: use Db
  replica: use Db
  rows: Rows
