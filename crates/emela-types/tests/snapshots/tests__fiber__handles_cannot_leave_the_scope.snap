expression: "render(r#\"\nimport Std.Fiber.{Fiber, Scope}\nimport Std.Deferred.{Deferred}\nimport Std.Queue.{Queue}\nimport Std.Semaphore.{Semaphore}\n\nfn handle() {\n  Fiber.scope(|_| Fiber.fork(|| 1))\n}\n\nfn optional() {\n  Fiber.scope(|_| Some(Fiber.fork(|| 1)))\n}\n\nfn deferred() {\n  with d = Deferred[Int] { (d, 1) }\n}\n\nfn joined() {\n  Fiber.scope(|_| Fiber.join(Fiber.fork(|| 1)))\n}\n\nfn piped() {\n  (|_| Fiber.fork(|| 1)) |> Fiber.scope()\n}\n\nfn semaphore() {\n  with s = Semaphore(permits: 2) { s }\n}\n\nfn queue() {\n  with q = Queue[Int](capacity: 1) { [q] }\n}\n\"#)"
