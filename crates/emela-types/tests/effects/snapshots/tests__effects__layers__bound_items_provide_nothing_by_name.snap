---
source: crates/emela-types/tests/effects/layers.rs
expression: "render_handlers(r##\"\neffect Db {\n  fn name() -> String\n}\n\neffect Clock {\n  fn now() -> Int\n}\n\neffect Side of Db\n\neffect Names of Db default\n\nerror Down\n\nhandler PrimaryDb: Db {\n  fn name() { \"primary\" }\n}\n\nfn probe(n: Int) -> () fails Down { if n > 0 { fail Down } else { () } }\n\nhandler ReplicaDb: Db {\n  init {\n    probe(0)\n    ReplicaDb\n  }\n\n  fn name() { \"replica\" }\n}\n\nhandler Both: Db + Clock {\n  fn name() { \"both\" }\n  fn now() { 0 }\n}\n\nhandler NeedsDb: Clock {\n  fn now() {\n    _ = (use Db).name()\n    0\n  }\n}\n\nfn write_side() -> String uses { Db } { (use Db).name() }\n\nfn names() -> String uses { Names } { (use Names).name() }\n\nfn show(side: use Side) -> String { side.name() }\n\nfn now() -> Int uses { Clock } { (use Clock).now() }\n\nfn left_to_caller() {\n  with replica = ReplicaDb { \"#{replica.name()} #{write_side()}\" }\n}\n\nfn outer() {\n  with PrimaryDb {\n    with replica = ReplicaDb { \"#{replica.name()} #{write_side()}\" }\n  }\n}\n\nfn several() {\n  with both = Both { \"#{both.name()} #{now()}\" }\n}\n\nfn label() {\n  with side = Side by ReplicaDb { \"#{show(side)} #{write_side()}\" }\n}\n\nfn no_default() {\n  with replica = ReplicaDb { names() }\n}\n\nfn requirement() {\n  with replica = ReplicaDb, NeedsDb { now() }\n}\n\nfn never_overridden() {\n  with PrimaryDb, a = ReplicaDb, b = PrimaryDb {\n    \"#{a.name()} #{b.name()} #{write_side()}\"\n  }\n}\n\"##)"
---
probe: fn(Int) -> () fails Down
write_side: fn() -> String uses { Db }
names: fn() -> String uses { Names }
show: fn(use Side) -> String uses { side }
now: fn() -> Int uses { Clock }
left_to_caller: fn() -> String fails Down uses { Db }
outer: fn() -> String fails Down
several: fn() -> String uses { Clock }
label: fn() -> String fails Down uses { Db }
no_default: fn() -> String fails Down uses { Names }
requirement: fn() -> Int fails Down uses { Db }
never_overridden: fn() -> String fails Down
handler PrimaryDb: use {}
handler ReplicaDb: use {}
handler Both: use {}
handler NeedsDb: use Db
handler ReplicaDb: init fails Down
with replica = ReplicaDb: init [ReplicaDb]
with PrimaryDb: init [PrimaryDb]
with replica = ReplicaDb: init [ReplicaDb]
with both = Both: init [Both, Both]
with side = Side by ReplicaDb: init [Side by ReplicaDb]
with replica = ReplicaDb: init [ReplicaDb]
with replica = ReplicaDb, NeedsDb: init [ReplicaDb, NeedsDb]
with PrimaryDb, a = ReplicaDb, b = PrimaryDb: init [PrimaryDb, ReplicaDb, PrimaryDb]
