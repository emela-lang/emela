# Spec 6.5, 17.6: `-` before a number literal, in patterns only.
fn f(n: Int, x: Float, p: (Int, Int)) -> Int {
  (-1, y) = p
  n match {
    -2147483648 -> 0
    -0x10 -> 1
    -0b11 -> 2
    -1 -> y
    _ -> 3
  }
}

fn g(x: Float) -> Int {
  x match {
    -1.5 -> 0
    -0.0 -> 1
    _ -> 3
  }
}
