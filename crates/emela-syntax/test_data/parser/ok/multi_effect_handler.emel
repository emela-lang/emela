handler SystemTx(conn: Connection): Query + Execute {
  init(url: String) { Self(conn: connect(url)) }
  release { close(self.conn) }
  suspend fn query(sql, resume) { resume(run(self.conn, sql)) }
  fn execute(sql) { exec(self.conn, sql) }
}

handler Mixed: State[Int] + Std.Log.Log + Clock {
  fn get() { 0 }
}

effect Files {
  handler Lock(path: String): ReadFile + WriteFile
    fails FileNotFound | FileAccessDenied
  handler Temporary(): ReadFile + WriteFile + TemporaryFile fails FileAccessDenied
}

fn copy(src: use ReadFile, dst: use ReadFile + WriteFile) -> () {
  dst.write(src.read())
}

fn each(fs: List[use State[Int] + Log], f: fn(use Query + Execute) -> use Query) {
  x: use ReadFile + WriteFile = use ReadFile
  ()
}
