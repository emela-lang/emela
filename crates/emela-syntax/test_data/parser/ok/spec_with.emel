fn h() {
  with ConsoleLogger { greet(1) }
  with AppTest, FixedClock { greet(1) }
  with PrimaryDb {
    primary = use Db
    with ReplicaDb {
      replica = use Db
      replica.query("...")
      primary.execute("...")
    }
  }
  List.map(names, fn(n) { log.info(n) })
  match xs {
    [] -> 0
    [x, ..rest] -> x
    User(name:, ..) -> 1
    (a, b) -> 2
    MAX_SIZE -> 3
  }
}
