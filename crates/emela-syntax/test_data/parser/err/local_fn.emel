# E0150: 型パラメータ，属性，pub，suspend
fn modifiers() -> Int {
  fn generic[A](x: A) -> A { x }
  @test
  fn annotated() { () }
  pub fn public() -> Int { 1 }
  suspend fn later() -> Int { 1 }
  1
}

