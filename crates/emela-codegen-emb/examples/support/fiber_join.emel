import Std.Fiber.{Fiber}
import Std.Exit.{Success, Failure}
pub fn work(n: Int) -> Int uses { Async } {
  Fiber.scope(|| {
    child = Fiber.fork(|| n + 1)
    first = Fiber.join(child)
    second = Fiber.await(child) match {
      Success(v) -> v
      Failure(_) -> -1
    }
    first + second
  })
}
