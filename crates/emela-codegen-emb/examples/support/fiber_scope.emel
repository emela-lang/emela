import Std.Fiber.{Fiber}

@external(c, "host_wait")
suspend fn wait(n: Int) -> Int
@external(c, "mark")
fn mark(n: Int) -> () use {}

effect Wait { suspend fn get(n: Int) -> Int }
handler Waiting: Wait {
  suspend fn get(n, resume) { resume(wait(n)) }
}

pub fn work(n: Int) -> Int use Async {
  with Waiting {
    Fiber.scope(fn() {
      Fiber.fork(fn() {
        mark(2)
        (use Wait).get(n + 1)
      })
      mark(1)
      result = (use Wait).get(n)
      mark(3)
      result
    })
  }
}
