import Std.Fiber.{Fiber, Scope}
import Std.Deferred.{Deferred}

pub fn work(n: Int) -> Int uses { Async } {
  Fiber.scope(|| {
    d: Deferred[Int] = (use Scope).deferred()
    Fiber.fork(|| Deferred.complete(d, n))
    first = Deferred.await(d)
    second = Deferred.await(d)
    first + second
  })
}
