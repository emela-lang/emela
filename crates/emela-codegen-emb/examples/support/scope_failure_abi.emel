import Std.Fiber.{Fiber}
import Std.Exit.{Success, Failure}
error Boom(n: Int) derive Show
pub fn good(n: Int) -> Int use Async {
 Fiber.scope(|| {
  child=Fiber.fork(|| n+1)
  Fiber.join(child)
  Fiber.await(child) match { Success(n) -> n
   Failure(_) -> panic("unexpected")
  }
 })
}
pub fn bad(n: Int) -> Int use Async {
 Fiber.scope(|| {
  child=Fiber.fork(|| fail Boom(n: n))
  Fiber.join(child)
  0
 }) escape { Boom(n) -> n }
}
pub fn nested(n: Int) -> Int use Async {
 Fiber.scope(|| {
  first=Fiber.fork(|| n)
  result=Fiber.scope(|| {
   child=Fiber.fork(|| fail Boom(n: n))
   Fiber.join(child)
   0
  }) escape { Boom(n) -> n+1 }
  Fiber.join(first)+result
 })
}
