import Std.Fiber.{Fiber}
import Std.Exit.{Success, Failure}
import Std.Cause.{Cause}
@external(c, "host_wait")
suspend fn wait(n: Int) -> Int
error Boom(n: Int) derive Show
effect Wait { suspend fn get(n: Int) -> Int }
handler Waiting: Wait { suspend fn get(n, resume) { resume(wait(n)) } }
fn late(n: Int) -> Int fails Boom uses { Wait } { (use Wait).get(n)
 fail Boom(n: n)
}
pub fn work() -> Cause[Boom] uses { Async } {
 with Waiting {
  Exit.attempt(|| { Fiber.scope(|| {
   Fiber.fork(|| late(1))
   Fiber.fork(|| late(2))
   Fiber.fork(|| late(3))
   (use Wait).get(4)
  }) }) match { Success(_) -> panic("unexpected")
   Failure(c) -> c
  }
 }
}
pub fn rethrow(c: Cause[Boom]) -> Cause[Boom] {
 Exit.attempt(|| Cause.raise(c)) match { Success(_) -> panic("unexpected")
  Failure(again) -> again
 }
}
pub fn rethrow_async(c: Cause[Boom]) -> Cause[Boom] uses { Async } {
 Exit.attempt(|| Fiber.scope(|| Cause.raise(c))) match {
  Success(_) -> panic("unexpected")
  Failure(again) -> again
 }
}
pub fn show(c: Cause[Boom]) -> String { Cause.to_string(c) }
pub fn caught(c: Cause[Boom]) -> Int { Cause.raise(c) escape { Boom(n) -> n } }
