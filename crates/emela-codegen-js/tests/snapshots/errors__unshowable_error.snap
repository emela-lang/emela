  for (const child of scope.children) child.interrupt(null);
  if (scope.children.size > 0) {
    fiber.holds++;
    try {
      yield new $FiberRequest((_, wake) => {
        if (scope.children.size === 0) return { mode: "next", value: undefined };
        scope.closer = () => wake("next", undefined);
        return undefined;
      }, true);
