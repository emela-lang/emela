  // Calls `settled()` once the fiber has ended: right away (returning its result) or later (passing its result to
  // `wake`). `settled` returns `{ mode, value }`.
  watch(wake, settled) {
    if (this.result !== undefined) return settled();
    this.watchers.push(() => {
      const now = settled();
      wake(now.mode, now.value);
    });
