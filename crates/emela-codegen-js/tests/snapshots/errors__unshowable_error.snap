  interrupt() {
    if (this.over) return;
    for (const fiber of this.fibers) {
      if (!fiber.unwinding && !fiber.pending.includes(null)) fiber.pending.push(null);
    }
    const waits = [...this.waits].reverse().filter((wait) => !wait.closing);
    for (const wait of waits) {
