export suspend fn main() -> Int {
  fiber#scope(suspend fn(s%0: fiber_scope) -> any fails {
    let h%1: Fiber[Int] = fiber#fork(s%0, suspend fn() -> any fails {
      1
    })
    let _%2: Exit[Int, ()] = fiber#await[Exit](h%1)!
    fiber#join(h%1)!
  })!?
}
