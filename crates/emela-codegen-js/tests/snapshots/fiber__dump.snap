export suspend fn main() -> Int {
  fiber#scope(suspend fn(s%7: fiber_scope) {
    let h%8: Fiber[Int] = fiber#fork(s%7, suspend fn() {
      1
    })
    let _%9: Exit[Int, ()] = fiber#await[Exit](h%8)!
    fiber#join(h%8)!
  })!?
}
