      call
        Email.to_string
        email#1
fn Main.safe
  param input#2: String
  ret Option[Email.Email]
  body
    block
      escape
        call
          Option.Some
          call
            Email.parse
            input#2
        arm Email.InvalidEmail(input: _)
          Option.None
