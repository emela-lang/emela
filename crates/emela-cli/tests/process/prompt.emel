# `print` before `read_line`: the prompt reaches the host before the program waits for input
# (`[api.std.process]`).

import Std.Process.{InvalidInput, Process, Stdin, StdinFailure, Stdout}

fn main() -> () fails InvalidInput | StdinFailure uses { Async } {
  with Process {
    stdout <- Stdout
    stdout.print("name? ")
    stdin <- Stdin
    stdin.read_line() match {
      Some(name) -> stdout.print_line("Hello, #{name}!")
      None       -> ()
    }
  }
}
