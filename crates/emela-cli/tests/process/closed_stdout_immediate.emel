# `closed_stdout.emel` in a program that never suspends: no Async, no fiber. What unwinds is not
# caught by `Exit.attempt`, and the program exits with 141 after the release ran.

import Std.Exit.{Exit}
import Std.Process.{Stderr, Stdout, SystemStderr, SystemStdout}

effect Guard {
  fn check() -> ()
}

handler Released: Guard {
  init { Released }
  fn check() { () }
  release { (use Stderr).print_line("released") }
}

fn forever(i: Int) -> () uses { Stdout } {
  (use Stdout).print_line("line #{i}")
  forever(i + 1)
}

fn main() {
  with SystemStdout, SystemStderr {
    _ = Exit.attempt(|| with Released { forever(0) })
    (use Stderr).print_line("caught")
  }
}
