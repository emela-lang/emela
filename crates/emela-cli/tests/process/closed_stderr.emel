# Writing to a standard error whose reader has closed it (`[api.std.process]`): the writes are
# discarded and the program goes on. Standard output gets `done` at the end.

import Std.Console.{Console}
import Std.Process.{Process, Stderr, Stdout}

fn errors(i: Int) -> () uses { Console, Stderr } {
  if i < 20000 {
    stderr <- Stderr
    stderr.print_line("error #{i}")
    console <- Console
    console.print_error_line("console error #{i}")
    dbg(i)
    errors(i + 1)
  }
}

fn main() {
  with Process {
    errors(0)
    stdout <- Stdout
    stdout.print_line("done")
  }
}
