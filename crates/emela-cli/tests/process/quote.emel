# The example of `[api.std.process]`: each line of standard input with the prefix in the first
# argument.

import Std.Console.{Console}
import Std.Process.{Args, InvalidInput, Process, Stdin, StdinFailure}

fn quote(prefix: String) -> () fails InvalidInput | StdinFailure uses { Console, Stdin } {
  stdin <- Stdin
  stdin.read_line() match {
    None -> ()
    Some(line) -> {
      console <- Console
      console.print_line("#{prefix}#{line}")
      quote(prefix)
    }
  }
}

fn main() {
  with Process {
    args <- Args
    prefix = args.get(0) match {
      Some(p) -> p
      None    -> "> "
    }
    quote(prefix)
  }
}
