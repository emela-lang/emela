# `closed_stdout.emel` in a program that suspends but forks no fiber. What unwinds is not caught
# by `Exit.attempt`, and the program exits with 141 after the release ran.

import Std.Clock.{Clock}
import Std.Exit.{Exit}
import Std.Process.{Process, Stderr, Stdout}

effect Guard {
  fn check() -> ()
}

handler Released: Guard {
  init { Self }
  fn check() { () }
  release {
    stderr <- Stderr
    stderr.print_line("released")
  }
}

fn forever(i: Int) -> () uses { Stdout } {
  stdout <- Stdout
  stdout.print_line("line #{i}")
  forever(i + 1)
}

fn main() -> () uses { Async } {
  with Process {
    clock <- Clock
    clock.sleep(1)
    _ = Exit.attempt(|| with Released { forever(0) })
    stderr <- Stderr
    stderr.print_line("caught")
  }
}
