# Writes mixed between Console, Stdout, Stderr and `dbg` keep their order (`[api.std.process]`),
# also when standard output and standard error go to the same pipe.

import Std.Console.{Console}
import Std.Process.{Process, Stderr, Stdout}

fn lines(i: Int, n: Int) -> () uses { Console, Stdout, Stderr } {
  if i < n {
    stdout <- Stdout
    stdout.print("out #{i}")
    stdout <- Stdout
    stdout.print_line("")
    console <- Console
    console.print_line("console #{i}")
    if i % 100 == 0 {
      stderr <- Stderr
      stderr.print("err ")
      stderr <- Stderr
      stderr.print_line("#{i}")
      console <- Console
      console.print_error_line("console error #{i}")
      _ = dbg(i)
    }
    lines(i + 1, n)
  }
}

fn main() {
  with Process { lines(0, 5000) }
}
