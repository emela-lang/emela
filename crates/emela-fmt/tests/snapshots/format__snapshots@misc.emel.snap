  todo()
}

fn patterns(x: Value) {
  match x {
    _                       -> 0
    MAX_SIZE                -> 1
    "text"                  -> 2
    3.14                    -> 3
    ()                      -> 4
    (a, b)                  -> 5
    []                      -> 6
    [h, ..]                 -> 7
    [h, ..t]                -> 8
    User(name:, age: n, ..) -> 9
    Wrapper(..)             -> 10
    Http.Status(code)       -> 11
  }
}

fn expressions(xs: List[Int]) {
  unit = ()
  paren = (a + b) * c
  list = [1, 2, ..xs]
  call = f()(x).field.other
  neg = -x
  not = !flag
  path = Http.Client.get
  block = {
    a = 1
    a + 1
  }
  inline = { 1 }
  empty_block = {}
  lambda = fn(x: Int, y) { x + y }
  no_args = fn() { 0 }
  assert x == 1
  fail Oops
  with Logs { use Logs }
  else_if = if a { 1 } else if b { 2 } else { 3 }
  else_if_long = if a {
    1
  } else if b {
    2
  } else {
    3
  }
  escape_inline = load(id) escape { NotFound(_) -> 0 }
  self_param = self.field
}

