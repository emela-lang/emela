---
source: crates/emela-fmt/tests/format.rs
expression: "check(&name, &src, 100)"
input_file: crates/emela-fmt/test_data/handler_init_args.emel
---
handler WorkerKv(ns: Namespace): Kv {
  init(binding: String, retries: Int) { WorkerKv(ns: kv_namespace(binding)) }
  fn get(key) { get(self.ns, key) }
}

layer AppLive {
  SystemConsole
  WorkerKv(binding: "KV", retries: 3)
}

fn main() {
  with WorkerKv(binding: "KV", retries: 3), AuditLog by FileLog(path: "audit.log") { run() }
  with AppLive, WorkerKv(binding: name, retries:) { run() }
  with WorkerKv(
    binding: "a long binding name that does not fit",
    retries: 1000000,
  ), AuditLog by FileLog(path: "a/long/path/to/the/audit.log") { run() }
}
