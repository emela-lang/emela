# 10章の trait と impl
trait Show {
  fn show(self) -> String
}

trait Ord: Eq { # Eq を前提とする
  fn compare(self, other: Self) -> Ordering

  fn max(self, other: Self) -> Self { # 既定の実装
    Ord.compare(self, other) match {
      Less -> other
      _    -> self
    }
  }
}

trait Decode {
  fn decode(json: Json) -> Self fails DecodeError
}

trait Both: Show + Ord {}

impl User: Show {
  fn show(self) { "User(#{self.name})" }
}

type MyDate(inner: ThirdParty.Date)

impl MyDate: Encode { fn encode(self) { todo() } }

impl List[A]: Show {
  fn show(self) { "list" }
}

impl Pair[A: Eq, B: Eq]: Eq {
  fn eq(self, other) { Eq.eq(self.first, other.first) && Eq.eq(self.second, other.second) }
}

impl Map[K: Eq + Ord, V: Eq]: Eq { fn eq(self, other) { True } }

fn largest[A: Ord](xs: List[A]) -> Option[A] { todo() }

type User(id: Int, name: String, email: Email)
  derive Eq, Show, Encode
