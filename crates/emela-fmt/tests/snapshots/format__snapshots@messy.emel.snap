pub fn messy(x: Int, y: Int) -> Int {
  a = x + y * 2
  b = if a > 0 { a } else { 0 - a }
  match b {
    0            -> "zero"
    n if n > 100 -> "big"
    _            -> "other"
  }
}
fn squeezed(xs: List[Int]) -> List[Int] {
  xs |> List.map(fn(x) { x * 2 }) |> List.filter(fn(x) { x > 2 })
}
fn tight(a: Int, b: Int) -> Bool { !(a == b) && -a < b || a >= -b }

