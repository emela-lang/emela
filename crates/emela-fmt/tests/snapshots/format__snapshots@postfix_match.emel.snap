---
source: crates/emela-fmt/tests/format.rs
expression: "check(&name, &src, 100)"
input_file: crates/emela-fmt/test_data/postfix_match.emel
---
# Postfix match and escape (spec 6.5). A broken pipe puts the keyword on its own line.
fn f(id: Int) -> String {
  name = registered_users
    |> List.filter(|u| u.active)
    |> List.find(|u| u.id == id)
    |> Option.map(|u| u.name)
    escape {
      NotFound(_) -> "guest"
    }
  short = users |> List.find(|u| u.id == id) match {
    Some(u) -> u.name
    None    -> "guest"
  }
  name2 = registered_users
    |> List.filter(|u| u.active)
    |> List.find(|u| u.id == id)
    |> Option.map(|u| u.name)
    match {
      Some(u) -> u
      None    -> "guest"
    }
  load(id) match {
    Some(user) -> user.name
    None       -> "guest"
  } escape {
    DbError(_) -> "unavailable"
  }
}

fn g(xs: List[Int]) -> Int {
  xs |> List.map(|x| {
    y = x + 1
    y * 2
  }) match {
    [] -> 0
    _  -> 1
  }
  xs
    |> List.map(f)
    match { _ -> 1 }
}
