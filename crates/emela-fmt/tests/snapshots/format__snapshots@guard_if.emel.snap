---
source: crates/emela-fmt/tests/format.rs
expression: "check(&name, &src, 100)"
input_file: crates/emela-fmt/test_data/guard_if.emel
---
# A guard written after `if` (W1401) is rewritten as `where`, and the `->` of the arms are
# aligned after the rewrite (`[fmt.block]`).
fn area(shape: Shape) -> Float {
  shape match {
    Circle(radius:) where radius > 0.0 -> 3.14 * radius * radius
    Circle(_)                          -> 0.0
    Rect(w, h)                         -> w * h
    Empty                              -> 0.0
  }
}

fn load(id: Int) -> String {
  find(id) escape {
    NotFound(key) where key == id -> "missing"
    DbError(_)                    -> "unavailable"
  }
}

fn sign(o: Option[Int], b: Bool) -> Int {
  o match {
    Some(x) where if b { x > 0 } else { x < 0 } -> 1
    _                                           -> 0
  }
}

fn one(o: Option[Int]) -> Int {
  o match { Some(x) where x > 0 -> x }
}

fn kept(o: Option[Int]) -> Int {
  o match {
    Some(x) where x > 0 -> x
    _                   -> 0
  }
}
