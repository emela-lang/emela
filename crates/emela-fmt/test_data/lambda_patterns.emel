# 無名関数の引数のパターン（6.1）
fn f(pairs: List[(String, Int)], reqs: List[Request]) {
  total = List.fold(pairs, from: 0, f: |acc,(_,n)| acc + n)
  keys = List.map(pairs, |(key , value)| key)
  urls = List.map(reqs, |Request(url:,..)| url)
  sum = |(a, b):(Int,Int)| a + b
  heads = |[x, ..], Some(y), ()| x + y
  long = List.fold(pairs, from: 0, f: |accumulator, (some_long_key_name, some_long_value_name): (String, Int)| accumulator + some_long_value_name)
}
