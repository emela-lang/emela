pub effect State[S] {
  fn get() -> S
  fn update(f: fn(S) -> S) -> ()
}

handler Fixed: State[ Int ] {
  fn get() { 0 }
  fn update(f) { () }
}

fn count() -> Int uses { State[Int],Log } {
  st = use State[ Int ]
  (use State[Int]).update(|n| n + 1)
  st.get()
}

pub effect Scope[E, R] {
  fn fork[ A ](f: fn() -> A fails E uses { R }) -> Fiber[A]
  fn deferred[A,B]() -> Deferred[A]
}
