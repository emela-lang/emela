# エフェクトと集合の型引数を混ぜた use 節（8.3）
effect Quiet {
  fn hush() -> ()
}

fn run[R](f: fn() -> () uses {Quiet,R}) -> () uses { R } {
  with Silent { f() }
}

fn both[R](f: fn() -> () uses {   R, Quiet, Http.Client }) -> () uses { R,Http.Client } {
  with Silent { f() }
}

fn long[R](f: fn() -> () uses { Quiet, Logger, Clock, Random, Http.Client, R }) -> () uses { Logger, Clock, Random, Http.Client, R } {
  with Silent { f() }
}
