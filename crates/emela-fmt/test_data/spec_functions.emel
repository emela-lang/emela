fn bindings(xs: List[Int], scores: Map[String, Int]) {
  count = 0
  count = count + 1            # 同名での束縛し直し
  (evens, odds) = List.partition(xs, is_even)
  pairs: List[(String, Int)] = Map.to_list(scores)
}

fn conditions(count: Int, valid: Bool, input: String) {
  label = if count > 0 { "あり" } else { "なし" }

  if !valid { fail Invalid(input:) }
}

fn area(shape: Shape) -> Float {
  match shape {
    Circle(radius:) if radius > 0.0 -> 3.14 * radius * radius
    Circle(_)                       -> 0.0
    Rect(w, h)                      -> w * h
    Empty                           -> 0.0
  }
}

fn pipes(scores: List[Int]) {
  scores
    |> List.filter(is_valid)
    |> List.fold(init: 0, f: add)
}
