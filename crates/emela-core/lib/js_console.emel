# The JS handler for Console (spec 15.2). Stateless.

import Console.{Console}

@external(js, "console.log")
fn console_log(text: String) -> ()

@external(js, "console.error")
fn console_error(text: String) -> ()

## `print_line` uses `console.log` (stdout); `print_error_line` uses `console.error` (stderr).
pub handler JsConsole implements Console {
  fn print_line(text) { console_log(text) }
  fn print_error_line(text) { console_error(text) }
}
