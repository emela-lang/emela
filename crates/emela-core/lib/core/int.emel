# Functions on Int (32-bit signed). Overflow wraps in two's complement (spec 16.1).
#
# `parse` is written in Emela over the private builtin `parse_or_none`, since a builtin cannot
# fail.

## Decimal digits, with `-` if negative.
@intrinsic
pub fn to_string(n: Int) -> String

## Reads decimal digits, with an optional leading `-` or `+`: `Int.parse("-42")` is -42.
## Fails with `ParseError` if anything else is in `s` (including spaces), or if the value is outside
## the range of Int.
pub fn parse(s: String) -> Int fails ParseError {
  parse_or_none(s) match {
    Some(n) -> n
    None    -> fail ParseError(input: s)
  }
}

@intrinsic
fn parse_or_none(s: String) -> Option[Int]

## `None` on overflow.
@intrinsic
pub fn checked_add(a: Int, b: Int) -> Option[Int]

## Reads as `flags |> Int.bit_and(MASK)`.
@intrinsic
pub fn bit_and(a: Int, b: Int) -> Int

@intrinsic
pub fn bit_or(a: Int, b: Int) -> Int

@intrinsic
pub fn bit_xor(a: Int, b: Int) -> Int

## Same as `-n - 1`.
@intrinsic
pub fn bit_not(n: Int) -> Int

## 0 if `by` is 32 or more; a defect if `by` is negative.
@intrinsic
pub fn shift_left(n: Int, by: Int) -> Int

## Arithmetic shift: fills the high bits with the sign.
## 0 or -1 if `by` is 32 or more; a defect if `by` is negative.
@intrinsic
pub fn shift_right(n: Int, by: Int) -> Int

## Logical shift: fills the high bits with 0. 0 if `by` is 32 or more; a defect if `by` is
## negative.
@intrinsic
pub fn shift_right_unsigned(n: Int, by: Int) -> Int

## Returns Less, Equal or Greater without subtracting (which could overflow).
pub fn compare(a: Int, b: Int) -> Ordering {
  if a < b {
    Less
  } else if a > b {
    Greater
  } else {
    Equal
  }
}

## Returns the larger value, or `a` when equal.
pub fn max(a: Int, b: Int) -> Int {
  compare(a, b) match {
    Less    -> b
    Greater -> a
    Equal   -> a
  }
}

## Returns the smaller value, or `a` when equal.
pub fn min(a: Int, b: Int) -> Int {
  compare(a, b) match {
    Less    -> a
    Greater -> b
    Equal   -> a
  }
}

## Absolute value. The minimum Int wraps back to itself, like integer negation.
pub fn abs(n: Int) -> Int {
  if n < 0 {
    -n
  } else {
    n
  }
}
