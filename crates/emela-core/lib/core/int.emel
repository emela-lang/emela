# Functions on Int (32-bit signed). Overflow wraps in two's complement (spec 16.1).

## Same as `String.from_int`.
@intrinsic
pub fn to_string(n: Int) -> String

## Every Int is exactly representable as a Float.
@intrinsic
pub fn to_float(n: Int) -> Float

## Same as `Int64.from_int`.
@intrinsic
pub fn to_int64(n: Int) -> Int64

## `None` on overflow.
@intrinsic
pub fn checked_add(a: Int, b: Int) -> Option[Int]

## Reads as `flags |> Int.bit_and(MASK)`.
@intrinsic
pub fn bit_and(a: Int, b: Int) -> Int

@intrinsic
pub fn bit_or(a: Int, b: Int) -> Int

@intrinsic
pub fn bit_xor(a: Int, b: Int) -> Int

## Same as `-n - 1`.
@intrinsic
pub fn bit_not(n: Int) -> Int

## 0 if `by` is 32 or more; a defect if `by` is negative.
@intrinsic
pub fn shift_left(n: Int, by: Int) -> Int

## Arithmetic shift: fills the high bits with the sign.
## 0 or -1 if `by` is 32 or more; a defect if `by` is negative.
@intrinsic
pub fn shift_right(n: Int, by: Int) -> Int

## Logical shift: fills the high bits with 0. 0 if `by` is 32 or more; a defect if `by` is
## negative.
@intrinsic
pub fn shift_right_unsigned(n: Int, by: Int) -> Int
