# Functions on Int64 (64-bit signed). Overflow wraps in two's complement (spec 16.1).

@intrinsic
pub fn from_int(n: Int) -> Int64

## No suffix is added.
@intrinsic
pub fn to_string(n: Int64) -> String

## Keeps the low 32 bits (wraps).
@intrinsic
pub fn to_int(n: Int64) -> Int

@intrinsic
pub fn bit_and(a: Int64, b: Int64) -> Int64

@intrinsic
pub fn bit_or(a: Int64, b: Int64) -> Int64

@intrinsic
pub fn bit_xor(a: Int64, b: Int64) -> Int64

@intrinsic
pub fn bit_not(n: Int64) -> Int64

## 0 if `by` is 64 or more; a defect if `by` is negative.
@intrinsic
pub fn shift_left(n: Int64, by: Int) -> Int64

## Arithmetic shift: fills the high bits with the sign.
## 0 or -1 if `by` is 64 or more; a defect if `by` is negative.
@intrinsic
pub fn shift_right(n: Int64, by: Int) -> Int64

## Logical shift: fills the high bits with 0. 0 if `by` is 64 or more; a defect if `by` is
## negative.
@intrinsic
pub fn shift_right_unsigned(n: Int64, by: Int) -> Int64

## Less, Equal or Greater as `a` is less than, equal to or greater than `b`.
pub fn compare(a: Int64, b: Int64) -> Ordering {
  if a < b {
    Less
  } else if a > b {
    Greater
  } else {
    Equal
  }
}

## The first argument if they are equal.
pub fn min(a: Int64, b: Int64) -> Int64 {
  compare(a, b) match {
    Greater -> b
    _       -> a
  }
}

## The first argument if they are equal.
pub fn max(a: Int64, b: Int64) -> Int64 {
  compare(a, b) match {
    Less -> b
    _    -> a
  }
}

## The minimum Int64 wraps to itself (spec 16.1).
pub fn abs(n: Int64) -> Int64 {
  if n < 0 { -n } else { n }
}
