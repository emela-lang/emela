# Functions on Float (IEEE 754 binary64).
# Converting to Int is a defect if the result is NaN, ±Infinity or outside the range of Int
# (spec 16.1).
#
# `parse` is written in Emela over the private builtin `parse_or_none`, since a builtin cannot
# fail.

## Every Int is exactly representable as a Float.
@intrinsic
pub fn from_int(n: Int) -> Float

## Reads a decimal number in the forms that `to_string` writes: digits with an optional `.` and
## fraction, an optional exponent (`1e+21`), an optional leading `-` or `+`, and `Infinity`,
## `-Infinity`, `NaN`. Fails with `ParseError` otherwise (including spaces).
pub fn parse(s: String) -> Float fails ParseError {
  parse_or_none(s) match {
    Some(x) -> x
    None    -> fail ParseError(input: s)
  }
}

@intrinsic
fn parse_or_none(s: String) -> Option[Float]

## The shortest digits that round-trip. A finite integral value gets a `.0` suffix, as in `1.0`
## (spec 10.6).
@intrinsic
pub fn to_string(x: Float) -> String

## Rounds toward negative infinity.
@intrinsic
pub fn floor(x: Float) -> Int

## Rounds toward positive infinity.
@intrinsic
pub fn ceil(x: Float) -> Int

## Rounds to the nearest integer, with ties away from zero (`2.5` is 3, `-2.5` is -3).
@intrinsic
pub fn round(x: Float) -> Int

## Rounds toward zero.
@intrinsic
pub fn truncate(x: Float) -> Int

## True only for NaN, the only Float unequal to itself under IEEE comparison.
pub fn is_nan(x: Float) -> Bool {
  x != x
}

## Orders NaN after all other values, with all NaNs comparing Equal.
## Positive and negative zero compare Equal. Unlike `==`, two NaNs compare Equal here.
pub fn compare(a: Float, b: Float) -> Ordering {
  (is_nan(a), is_nan(b)) match {
    (True, True) -> Equal
    (True, _)    -> Greater
    (_, True)    -> Less
    (False, False) -> {
      if a < b {
        Less
      } else if a > b {
        Greater
      } else {
        Equal
      }
    }
  }
}

## Returns the larger value under `compare`; either NaN makes the result NaN.
## Returns `a` on Equal, preserving its sign when the arguments are signed zeros.
pub fn max(a: Float, b: Float) -> Float {
  compare(a, b) match {
    Less    -> b
    Greater -> a
    Equal   -> a
  }
}

## Returns the smaller value under `compare`; a single NaN selects the other value.
## Returns `a` on Equal, including two NaNs or signed zeros.
pub fn min(a: Float, b: Float) -> Float {
  compare(a, b) match {
    Less    -> a
    Greater -> b
    Equal   -> a
  }
}

## Absolute value, mapping either signed zero to positive zero and leaving NaN unchanged.
pub fn abs(x: Float) -> Float {
  if x == 0.0 { 0.0 } else if x < 0.0 { -x } else { x }
}
