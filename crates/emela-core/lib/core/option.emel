# Functions on Option. Option itself is the Prelude enum (prelude.emel).
# The Option comes first as `opt`, so calls read as `opt |> Option.map(f)`.

pub fn map[A, B](opt: Option[A], f: fn(A) -> B) -> Option[B] {
  opt match {
    Some(x) -> Some(f(x))
    None    -> None
  }
}

pub fn and_then[A, B](opt: Option[A], f: fn(A) -> Option[B]) -> Option[B] {
  opt match {
    Some(x) -> f(x)
    None    -> None
  }
}

## The value, or `default` if `None`.
pub fn or[A](opt: Option[A], default: A) -> A {
  opt match {
    Some(x) -> x
    None    -> default
  }
}

pub fn is_some[A](opt: Option[A]) -> Bool {
  opt match {
    Some(_) -> True
    None    -> False
  }
}

pub fn is_none[A](opt: Option[A]) -> Bool {
  opt match {
    Some(_) -> False
    None    -> True
  }
}

## Fails with `err` if `None` (spec 7.2). Turns an Option into a failure, as in
## `users.find(id) |> Option.or_fail(NotFound(id:))`.
pub fn or_fail[A, E](opt: Option[A], err: E) -> A fails E {
  opt match {
    Some(x) -> x
    None    -> fail err
  }
}

# The built-in impls (spec 10.6). The value inside is compared and shown through its own impl.
# Ord puts `None` first: `None < Some(_)`, as in Haskell's `Nothing < Just _`.

impl Option[A: Eq]: Eq {
  fn eq(self, other) {
    (self, other) match {
      (Some(x), Some(y)) -> Eq.eq(x, y)
      (None, None)       -> True
      _                  -> False
    }
  }
}

impl Option[A: Ord]: Ord {
  fn compare(self, other) {
    (self, other) match {
      (Some(x), Some(y)) -> Ord.compare(x, y)
      (Some(_), None)    -> Greater
      (None, Some(_))    -> Less
      (None, None)       -> Equal
    }
  }
}

## `Some(1)`, `None`. A String inside is quoted (`Some("a")`).
impl Option[A: Show]: Show {
  fn show(self) {
    self match {
      Some(x) -> "Some(#{String.show_nested(x)})"
      None    -> "None"
    }
  }
}
