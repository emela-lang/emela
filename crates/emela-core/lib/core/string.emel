# Functions on String (spec 16.2). There is no API that takes a numeric position.
# The string comes first, so calls read as `s |> String.contains("@")`.

## The number of user-perceived characters (grapheme clusters). `length("👍")` is 1.
@intrinsic
pub fn length(s: String) -> Int

## The number of bytes in UTF-8.
@intrinsic
pub fn byte_size(s: String) -> Int

## Joins two strings: `String.append("ab", "cd")` is `"abcd"`.
@intrinsic
pub fn append(a: String, b: String) -> String

## Joins all the strings in order: `String.concat(["a", "b", "c"])` is `"abc"`.
pub fn concat(parts: List[String]) -> String {
  List.join(parts, "")
}

## Matches by code point sequence.
@intrinsic
pub fn contains(s: String, sub: String) -> Bool

@intrinsic
pub fn starts_with(s: String, prefix: String) -> Bool

@intrinsic
pub fn ends_with(s: String, suffix: String) -> Bool

## Splits into grapheme clusters if `sep` is empty.
## `List.join(split(s, sep), sep) == s` holds.
@intrinsic
pub fn split(s: String, sep: String) -> List[String]

## One string per grapheme cluster.
@intrinsic
pub fn chars(s: String) -> List[String]

## Moved to `List.join`, so that it reads as `parts.join(", ")`.
@deprecated("use `List.join`")
pub fn join(parts: List[String], sep: String) -> String {
  List.join(parts, sep)
}

## Removes leading and trailing whitespace (Unicode White_Space).
@intrinsic
pub fn trim(s: String) -> String

@intrinsic
pub fn code_points(s: String) -> List[Int]

## `None` if `n` is not a Unicode scalar value (0 to 10FFFF, excluding surrogates).
@intrinsic
pub fn from_code_point(n: Int) -> Option[String]

## The Show of a value shown inside another value (spec 10.6): a String is quoted and escaped
## (`"a\"b"`), any other type is its `Show.show`. For the Show impls in core (`[1, 2]`, `["a"]`).
@internal
@intrinsic
pub fn show_nested[A: Show](value: A) -> String

## `s` with A to Z changed to a to z. Other characters, including non-ASCII letters, are left as
## they are.
pub fn to_ascii_lowercase(s: String) -> String {
  lower = String.code_points(s) |> List.map(fn(c) {
    String.from_code_point(if c >= 65 && c <= 90 { c + 32 } else { c })
      |> Option.or("")
  })

  String.concat(lower)
}

## `s` with a to z changed to A to Z. Other characters, including non-ASCII letters, are left as
## they are.
pub fn to_ascii_uppercase(s: String) -> String {
  upper = String.code_points(s) |> List.map(fn(c) {
    String.from_code_point(if c >= 97 && c <= 122 { c - 32 } else { c })
      |> Option.or("")
  })

  String.concat(upper)
}
