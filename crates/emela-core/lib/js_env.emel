# The JS handler for Env (spec 15.2). `Option[String]` cannot cross the external function boundary
# (spec 12.4), so the host returns presence and value separately and the handler builds the Option.

import Env.{Env}

@external(js, "./js_env.mjs", "has")
fn env_has(name: String) -> Bool

@external(js, "./js_env.mjs", "get")
fn env_get(name: String) -> String

## Backed by JS `process.env`.
pub handler JsEnv implements Env {
  fn get(name) {
    if env_has(name) { Some(env_get(name)) } else { None }
  }
}
