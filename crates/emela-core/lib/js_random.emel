# The JS handler for Random (spec 15.2). Stateless.

import Random.{Random}

@external(js, "./js_random.mjs", "int")
fn random_int() -> Int

@external(js, "./js_random.mjs", "float")
fn random_float() -> Float

## Backed by JS `crypto.getRandomValues` (cryptographically secure).
pub handler JsRandom implements Random {
  fn int() { random_int() }
  fn float() { random_float() }
}
