# The Clock effect and its handlers (`[effect.decl]`; the platform and test layers of
# `[lib.layers]`).
#
# Use it as `clock <- Clock` and `clock.now()` and provide it with `with SystemClock { ... }`, or with
# `with Platform { ... }` from `Std.Platform`.
#
# Clock has a suspend fn, so every function that uses Clock may suspend, even one that only calls
# `now` (the marks follow R).
#
# How TestClock knows that no fiber can go on and the host has nothing pending is up to the
# runtime (`when_stalled`). It is reached as an `@external suspend fn`, not an `@intrinsic`: a
# suspending `@intrinsic` would need new paths in lowering and the type checker, and an
# `@external suspend fn` gets the AbortSignal, so interrupting a sleeper removes its wait, as for
# any external call (`[ext.call]`).

import Std.Duration.{Duration}
import Std.Instant.{Instant}
import Std.State.{State}

## The current point in time, and waiting.
pub effect Clock {
  ## Waits `ms` milliseconds. A negative `ms` is the same as 0.
  suspend fn sleep(ms: Int) -> ()
  ## The current point in time.
  fn now() -> Instant
}

@external(js, "./clock.mjs", "nowMilliseconds")
@external(c, "./clock.c", "emela_clock_now_milliseconds")
@external(wasm, "wasi:clocks/system-clock@0.3.0", "now")
fn now_milliseconds() -> Int64

@external(js, "./clock.mjs", "sleep")
@external(c, "./clock.c", "emela_clock_sleep")
@external(wasm, "wasi:clocks/monotonic-clock@0.3.0", "wait-for")
suspend fn sleep_milliseconds(ms: Int) -> ()

@external(js, "./clock.mjs", "whenStalled")
@external(c, "./clock.c", "emela_clock_when_stalled")
@external(wasm, "emela:runtime/scheduler@0.1.0", "when-stalled")
suspend fn when_stalled(at: Int64) -> ()

# `sleep` waits as an `@external suspend fn`, so SystemClock depends on Async, and interrupting the
# sleeping fiber clears the timer (`[ext.call]`, `[ext.c-host]`).
## The host's clock. `sleep` waits for a timer (JS `setTimeout`, C the runtime's event loop).
## SystemClock depends on Async (`[effect.async]`), and interrupting the sleeping fiber clears the
## timer. `now` is milliseconds since the Unix epoch (JS `Date.now()`).
pub handler SystemClock: Clock {
  suspend fn sleep(ms, resume) {
    sleep_milliseconds(ms)
    resume(())
  }
  fn now() { Instant.from_unix_milliseconds(now_milliseconds()) }
}

## The test handler. The current time is `State[Instant]`, so use it inside `State.run` with the
## starting time:
##
## ```emela
## start = Instant.from_unix_milliseconds(Int64.from_int(0))
## (_, end) = State.run(start, || with TestClock {
##   clock <- Clock
##   clock.sleep(1000)
## })
## ```
##
## The time is virtual (`[effect.state]`). `sleep` really waits: when no fiber can go on and the
## host has nothing pending, the time moves forward to the earliest time a sleeper waits for, and
## that sleeper wakes (sleepers with the same time wake in the order they called `sleep`). With one
## fiber this is the same as moving the time forward by `ms` at once. A negative `ms` is the same
## as 0. `now` returns the time in `State[Instant]`. TestClock depends on Async.
pub handler TestClock: Clock {
  suspend fn sleep(ms, resume) {
    st <- State[Instant]
    at = st.get().add(Duration.milliseconds(Int64.from_int(if ms < 0 { 0 } else { ms })))
    when_stalled(at.to_unix_milliseconds())
    st.update(|t| {
      t.compare(at) match {
        Less -> at
        _    -> t
      }
    })
    resume(())
  }
  fn now() {
    st <- State[Instant]
    st.get()
  }
}
