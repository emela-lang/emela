# An Instant is an opaque Int64 of milliseconds since the Unix epoch (1970-01-01T00:00:00Z)
# (spec 15.2, 4.4). Leap seconds are not counted.
#
# This module cannot read the current time; the Clock effect returns it.

import Std.Duration.{Duration}

pub opaque type Instant(milliseconds: Int64)
  derive Eq, Ord

## Negative values are before the epoch.
pub fn from_unix_milliseconds(ms: Int64) -> Instant {
  Instant(milliseconds: ms)
}

pub fn to_unix_milliseconds(t: Instant) -> Int64 {
  t.milliseconds
}

## Earlier if `d` is negative.
pub fn add(t: Instant, d: Duration) -> Instant {
  Instant(milliseconds: t.milliseconds + Duration.to_milliseconds(d))
}

pub fn subtract(t: Instant, d: Duration) -> Instant {
  Instant(milliseconds: t.milliseconds - Duration.to_milliseconds(d))
}

## The duration from `earlier` to `t`; negative if `earlier` is later.
## Reads as `now |> Instant.since(start)`.
pub fn since(t: Instant, earlier: Instant) -> Duration {
  Duration.milliseconds(t.milliseconds - earlier.milliseconds)
}

## UTC in ISO 8601 (`2026-10-12T03:04:05.678Z`). Same format as JS `Date.prototype.toISOString`:
## years outside 0 to 9999 are written with a sign and six digits (`+010000`, `-000001`).
pub fn to_string(t: Instant) -> String {
  days = floor_div(t.milliseconds, 86400000)
  ms_of_day = t.milliseconds - days * 86400000
  # Days to a civil date (proleptic Gregorian; H. Hinnant's civil_from_days).
  z = days + 719468
  era = floor_div(z, 146097)
  doe = z - era * 146097
  yoe = (doe - doe / 1460 + doe / 36524 - doe / 146096) / 365
  doy = doe - (365 * yoe + yoe / 4 - yoe / 100)
  mp = (5 * doy + 2) / 153
  day = doy - (153 * mp + 2) / 5 + 1
  month = if mp < 10 { mp + 3 } else { mp - 9 }
  year = if month <= 2 { yoe + era * 400 + 1 } else { yoe + era * 400 }
  hour = ms_of_day / 3600000
  minute = ms_of_day / 60000 % 60
  second = ms_of_day / 1000 % 60
  milli = ms_of_day % 1000
  date = "#{year_to_string(year)}-#{pad(month, 2)}-#{pad(day, 2)}"
  "#{date}T#{pad(hour, 2)}:#{pad(minute, 2)}:#{pad(second, 2)}.#{pad(milli, 3)}Z"
}

## `b` must be positive.
fn floor_div(a: Int64, b: Int64) -> Int64 {
  if a >= 0 { a / b } else { (a - b + 1) / b }
}

fn year_to_string(year: Int64) -> String {
  if year < 0 {
    "-#{pad(0 - year, 6)}"
  } else if year > 9999 {
    "+#{pad(year, 6)}"
  } else {
    pad(year, 4)
  }
}

## Zero-pads `n` to `width` digits. `n` must be non-negative.
fn pad(n: Int64, width: Int) -> String {
  pad_onto(Int64.to_string(n), width)
}

# Digits are ASCII, so bytes count them without the grapheme tables (which target c lacks).
fn pad_onto(s: String, width: Int) -> String {
  if String.byte_size(s) >= width { s } else { pad_onto("0#{s}", width) }
}

## Shown as `to_string` writes it (`2025-10-12T03:04:05.678Z`).
impl Instant: Show {
  fn show(self) { to_string(self) }
}
