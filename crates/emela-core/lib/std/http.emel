# The Http effect (a client), its handlers and the functions over `send` (the platform and test
# layers of spec 15.2), and the entry adapter `serve` of HTTP services (`[lib.http-service]`).
#
# Use it as `Http.get(url)` and provide it with `with SystemHttp { ... }`, or with
# `with Platform { ... }` from `Std.Platform`. Requests and responses are values in
# `Std.Http.Request` and `Std.Http.Response`, so building a request is an ordinary function that
# tests can call without a handler.

import Std.State.{State}
import Std.Console.{Console, SystemConsole}
import Std.Cause
import Std.Fiber.{Fiber, Success, Failure}
import Std.Http.Request.{Request, Method, Get, Head, Post, Put, Patch, Delete, Options}
import Std.Http.Response.{Response, UnexpectedStatus}

## The URL cannot be read as a URL.
pub error InvalidUrl(url: String) derive Show
## No response was received (name resolution, connection, TLS, too many redirects). `message` says why.
pub error ConnectionFailed(url: String, message: String) derive Show
## The response body is not valid UTF-8.
pub error ResponseNotText(url: String) derive Show

## Sends requests. 4xx and 5xx are responses, not failures; fail only when no response is received.
pub effect Http {
  suspend fn send(request: Request) -> Response
    fails InvalidUrl | ConnectionFailed | ResponseNotText
}

## Sends a GET request to `url`.
pub fn get(url: String) -> Response fails InvalidUrl | ConnectionFailed | ResponseNotText use Http {
  (use Http).send(Request.new(Get, url))
}

## Sends a POST request to `url` with `body`.
pub fn post(url: String, body: String) -> Response
  fails InvalidUrl | ConnectionFailed | ResponseNotText
  use Http {
  (use Http).send(Request(body:, ..Request.new(Post, url)))
}

## A request with no headers and an empty body.
@deprecated("use `Request.new` of `Std.Http.Request`")
pub fn request(method: Method, url: String) -> Request {
  Request.new(method, url)
}

## Adds a header after the ones already in `req`.
@deprecated("use `Request.add_header` of `Std.Http.Request`")
pub fn add_header(req: Request, name: String, value: String) -> Request {
  Request.add_header(req, name, value)
}

## The first value of the header `name`, compared without case.
@deprecated("use `Response.header` of `Std.Http.Response`")
pub fn header(res: Response, name: String) -> Option[String] {
  Response.header(res, name)
}

## All values of the header `name` in order, compared without case.
@deprecated("use `Response.header_values` of `Std.Http.Response`")
pub fn headers(res: Response, name: String) -> List[String] {
  Response.header_values(res, name)
}

## The query string of `pairs`, each part percent-encoded (`q=%E6%9D%B1&page=2`).
@deprecated("use `Request.encode_query` of `Std.Http.Request`")
pub fn encode_query(pairs: List[(String, String)]) -> String {
  Request.encode_query(pairs)
}

## `res` if its status is 2xx, otherwise fails with UnexpectedStatus.
@deprecated("use `Response.require_ok` of `Std.Http.Response`")
pub fn require_ok(res: Response) -> Response fails UnexpectedStatus {
  Response.require_ok(res)
}

## A response with no headers.
@deprecated("use `Response.new` of `Std.Http.Response`")
pub fn response(status: Int, body: String) -> Response {
  Response.new(status, body)
}

## The request being built on the host (a JS object). `List` cannot cross the external function
## boundary (spec 12.4), so the headers are added one by one.
@external
type HostRequest

## The outcome of a send on the host: a response, or the kind of failure and its message.
@external
type HostResponse

@external(js, "./http.mjs", "newRequest")
fn host_request(method: String, url: String, body: String) -> HostRequest

@external(js, "./http.mjs", "withHeader")
fn host_with_header(req: HostRequest, name: String, value: String) -> HostRequest

@external(js, "./http.mjs", "send")
suspend fn host_send(req: HostRequest) -> HostResponse

## 0 for a response, 1 for InvalidUrl, 2 for ConnectionFailed, 3 for ResponseNotText.
@external(js, "./http.mjs", "outcome")
fn host_outcome(res: HostResponse) -> Int

@external(js, "./http.mjs", "message")
fn host_message(res: HostResponse) -> String

@external(js, "./http.mjs", "status")
fn host_status(res: HostResponse) -> Int

@external(js, "./http.mjs", "body")
fn host_body(res: HostResponse) -> String

@external(js, "./http.mjs", "headerCount")
fn host_header_count(res: HostResponse) -> Int

@external(js, "./http.mjs", "headerName")
fn host_header_name(res: HostResponse, index: Int) -> String

@external(js, "./http.mjs", "headerValue")
fn host_header_value(res: HostResponse, index: Int) -> String

fn method_name(method: Method) -> String {
  method match {
    Get     -> "GET"
    Head    -> "HEAD"
    Post    -> "POST"
    Put     -> "PUT"
    Patch   -> "PATCH"
    Delete  -> "DELETE"
    Options -> "OPTIONS"
  }
}

## The host's HTTP client (JS `fetch`). It follows redirects, keeps no cookies and ignores the
## proxy environment variables. Interrupting the fiber waiting on `send` aborts the request
## (spec 12.2).
pub handler SystemHttp: Http {
  suspend fn send(request, resume) {
    start = host_request(method_name(request.method), request.url, request.body)
    req = List.fold(request.headers, from: start, f: fn(req, (name, value)) {
      host_with_header(req, name, value)
    })
    res = host_send(req)
    host_outcome(res) match {
      1 -> fail InvalidUrl(url: request.url)
      2 -> fail ConnectionFailed(url: request.url, message: host_message(res))
      3 -> fail ResponseNotText(url: request.url)
      _ -> {
        headers = List.map(List.range(0, host_header_count(res)), fn(i) {
          (host_header_name(res, i), host_header_value(res, i))
        })
        resume(Response(status: host_status(res), headers:, body: host_body(res)))
      }
    }
  }
}

## The server that TestHttp sends to. `respond` gets the request and how many requests were sent
## before it (from 0), and returns the response, or `None` for ConnectionFailed. `sent` holds the
## sent requests in order.
pub type TestServer(respond: fn(Request, Int) -> Option[Response], sent: List[Request])

## The test handler. The server is `State[TestServer]`, so use it inside `State.run`:
##
## ```emela
## server = TestServer(respond: fn(req, n) { Some(Response.new(200, "ok")) }, sent: [])
## (res, after) = State.run(server, fn() { with TestHttp { Http.get("https://example.com") } })
## ```
##
## `send` adds the request to `sent` and resumes at once. It never fails with InvalidUrl or
## ResponseNotText.
pub handler TestHttp: Http {
  suspend fn send(request, resume) {
    st = use State[TestServer]
    server = st.get()
    st.set(TestServer(sent: List.append(server.sent, [request]), ..server))
    respond = server.respond
    respond(request, List.length(server.sent)) match {
      Some(res) -> resume(res)
      None -> fail ConnectionFailed(url: request.url, message: "TestServer returned no response")
    }
  }
}

## The request as the host handed it over (JS: a Fetch API Request). Used only when writing an
## export by hand.
@external
pub type Incoming

## The response for the host to send (JS: a Fetch API Response).
@external
pub type Outgoing

## The entry of an HTTP service (`[lib.http-service]`): `@entry(Http.serve)` on `app` makes the
## host call `app` once for each request, and each call is one launch. The request is read whole
## before `app` runs. A method not in `Method` is answered with 405, and a body that is not UTF-8
## or a path or query with a malformed `%` with 400, without calling `app`. When `app` fails, has
## a defect or returns a response the host cannot send, the cause is written to standard error as
## one line and the response is 500; the cause is never in the response.
@export(js, "default", "fetch")
@export(wasm, "wasi:http/handler@0.3.0", "handle")
pub fn serve[E](app: fn(Request) -> Response fails E use { Async }, incoming: Incoming) -> Outgoing
  use { Async } {
  received = with SystemHostHttp { (use HostHttp).read(incoming) }
  response = received_request(received) match {
    None          -> status_only(405) |> Response.add_header("allow", ALLOW)
    Some(_) if !host_received_text(received) -> status_only(400)
    Some(request) if !well_formed(request) -> status_only(400)
    Some(request) -> launch(app, request)
  }
  to_outgoing(response)
}

const ALLOW: String = "GET, HEAD, POST, PUT, PATCH, DELETE, OPTIONS"

## Runs `app` and turns how it ends into the response to send.
fn launch[E](app: fn(Request) -> Response fails E use { Async }, request: Request) -> Response
  use { Async } {
  Fiber.attempt(fn() { app(request) }) match {
    Success(res) -> invalid_reason(res) match {
      None         -> with_content_type(res)
      Some(reason) -> failed("invalid response: #{reason}")
    }
    Failure(cause) -> failed(Cause.to_string(cause))
  }
}

## Writes `line` to standard error and answers with 500.
fn failed(line: String) -> Response {
  with SystemConsole { (use Console).print_error_line(line) }
  status_only(500)
}

## A response of the entry itself: the name of the status as the body.
fn status_only(status: Int) -> Response {
  name = status match {
    400 -> "Bad Request"
    405 -> "Method Not Allowed"
    _   -> "Internal Server Error"
  }
  Response.new(status, name) |> Response.add_header("content-type", TEXT)
}

const TEXT: String = "text/plain;charset=UTF-8"

## `res` with `content-type: text/plain;charset=UTF-8` added when it has a body and no
## content-type.
fn with_content_type(res: Response) -> Response {
  if res.body == "" || Response.header(res, "content-type") != None {
    res
  } else {
    res |> Response.add_header("content-type", TEXT)
  }
}

## Why the host cannot send `res`, in the order `[lib.http-service]` checks it, or `None`.
fn invalid_reason(res: Response) -> Option[String] {
  if res.status < 200 || res.status > 599 {
    Some("status #{res.status}")
  } else if (res.status == 204 || res.status == 205 || res.status == 304) && res.body != "" {
    Some("status #{res.status} cannot have a body")
  } else {
    List.find(res.headers, fn((name, _)) { !is_token(name) }) match {
      Some((name, _)) -> Some("header name `#{name}`")
      None -> List.find(res.headers, fn((_, value)) { !is_field_value(value) }) match {
        Some((name, _)) -> Some("header value of `#{name}`")
        None            -> None
      }
    }
  }
}

## A header name: ASCII letters, digits and ``!#$%&'*+-.^_`|~``, at least one.
fn is_token(name: String) -> Bool {
  name != ""
    && List.all(String.code_points(name), fn(c) {
      (c >= 0x30 && c <= 0x39)
        || (c >= 0x41 && c <= 0x5A)
        || (c >= 0x61 && c <= 0x7A)
        || List.any(String.code_points("!#$%&'*+-.^_`|~"), fn(t) { t == c })
    })
}

## A header value: a tab and the printable ASCII characters.
fn is_field_value(value: String) -> Bool {
  List.all(String.code_points(value), fn(c) { c == 0x09 || (c >= 0x20 && c <= 0x7E) })
}

## Whether the path and the query of `request` percent-decode. `decode_query` fails exactly when
## a `%` is malformed or the decoded bytes are not UTF-8; splitting at `&`, `=` and `/` (all
## ASCII) cannot break a valid sequence or make an invalid one valid, so it checks the path too.
## The query is the text after the first `?` of `url`: neither the scheme nor the authority can
## hold a `?`.
fn well_formed(request: Request) -> Bool {
  query = String.split(request.url, "?") |> List.drop(1) |> List.join("?")
  decodes(Request.path(request)) && decodes(query)
}

fn decodes(s: String) -> Bool {
  {
    Request.decode_query(s)
    True
  } escape {
    ParseError(input: _) -> False
  }
}

## The request the host read, or `None` if its method is not one of `Method`.
fn received_request(received: Received) -> Option[Request] {
  method = host_received_method(received) match {
    "GET"     -> Some(Get)
    "HEAD"    -> Some(Head)
    "POST"    -> Some(Post)
    "PUT"     -> Some(Put)
    "PATCH"   -> Some(Patch)
    "DELETE"  -> Some(Delete)
    "OPTIONS" -> Some(Options)
    _         -> None
  }
  method |> Option.map(fn(method) {
    headers = List.map(List.range(0, host_received_header_count(received)), fn(i) {
      (host_received_header_name(received, i), host_received_header_value(received, i))
    })
      |> normal_headers
    Request(method:, url: host_received_url(received), headers:, body: host_received_body(received))
  })
}

## `pairs` in the form of the headers of a client's `Response`: lower-case names sorted by name,
## and the values of the same name joined with `, `, except that each `set-cookie` stays its own
## pair. The sort is stable, so values keep the order received. The headers of the connection
## are left out (`CONNECTION_HEADERS`). The JS host reads them in this form already; the WASM host
## hands them over as received.
fn normal_headers(pairs: List[(String, String)]) -> List[(String, String)] {
  pairs
    |> List.map(fn((name, value)) { (String.to_ascii_lowercase(name), value) })
    |> List.filter(fn((name, _)) { !List.any(CONNECTION_HEADERS, fn(c) { c == name }) })
    |> List.sort_by(fn((a, _), (b, _)) {
      if a < b { Less } else if a > b { Greater } else { Equal }
    })
    |> List.fold(from: [], f: fn(acc, (name, value)) {
      acc match {
        [(last, joined), ..rest] if last == name && name != "set-cookie" -> [
          (name, "#{joined}, #{value}"),
          ..rest,
        ]
        _ -> [(name, value), ..acc]
      }
    })
    |> List.reverse
}

## The headers that belong to the connection, which hosts of `wasi:http` do not hand over
## (`[lib.http-service]`).
const CONNECTION_HEADERS: List[String] = [
  "connection",
  "keep-alive",
  "proxy-authenticate",
  "proxy-authorization",
  "proxy-connection",
  "transfer-encoding",
  "upgrade",
  "host",
  "http2-settings",
]

## The host's response for `res`, its headers in the written order.
fn to_outgoing(res: Response) -> Outgoing {
  draft = List.fold(res.headers, from: host_draft(res.status, res.body), f: fn(d, (name, value)) {
    host_draft_header(d, name, value)
  })
  host_finish(draft)
}

## Reads an incoming request on the host. Reading the body suspends, and an external function that
## suspends is called only inside a handler (`[ext.call]`), so it is an operation of this private
## effect.
effect HostHttp {
  suspend fn read(incoming: Incoming) -> Received
}

handler SystemHostHttp: HostHttp {
  suspend fn read(incoming, resume) {
    resume(host_read(incoming))
  }
}

## A request read on the host: its method, URL, headers and whole body. `List` cannot cross the
## external function boundary (spec 12.4), so the headers are read one by one by index. On WASM
## the runtime keeps the request being served, so the value only stands for it.
@external
type Received

@external(js, "./http.mjs", "readRequest")
@external(wasm, "emela:runtime/http@0.1.0", "read-request")
suspend fn host_read(incoming: Incoming) -> Received

## Whether the body is UTF-8. When it is not, the body is empty.
@external(js, "./http.mjs", "receivedText")
@external(wasm, "emela:runtime/http@0.1.0", "received-text")
fn host_received_text(received: Received) -> Bool use {}

@external(js, "./http.mjs", "receivedMethod")
@external(wasm, "emela:runtime/http@0.1.0", "received-method")
fn host_received_method(received: Received) -> String use {}

@external(js, "./http.mjs", "receivedUrl")
@external(wasm, "emela:runtime/http@0.1.0", "received-url")
fn host_received_url(received: Received) -> String use {}

@external(js, "./http.mjs", "body")
@external(wasm, "emela:runtime/http@0.1.0", "received-body")
fn host_received_body(received: Received) -> String use {}

@external(js, "./http.mjs", "headerCount")
@external(wasm, "emela:runtime/http@0.1.0", "received-header-count")
fn host_received_header_count(received: Received) -> Int use {}

@external(js, "./http.mjs", "headerName")
@external(wasm, "emela:runtime/http@0.1.0", "received-header-name")
fn host_received_header_name(received: Received, index: Int) -> String use {}

@external(js, "./http.mjs", "headerValue")
@external(wasm, "emela:runtime/http@0.1.0", "received-header-value")
fn host_received_header_value(received: Received, index: Int) -> String use {}

## The response being built on the host. On WASM the runtime keeps the response being built, so
## the value only stands for it.
@external
type Draft

@external(js, "./http.mjs", "newDraft")
@external(wasm, "emela:runtime/http@0.1.0", "new-draft")
fn host_draft(status: Int, body: String) -> Draft use {}

@external(js, "./http.mjs", "withHeader")
@external(wasm, "emela:runtime/http@0.1.0", "draft-header")
fn host_draft_header(draft: Draft, name: String, value: String) -> Draft use {}

@external(js, "./http.mjs", "finishDraft")
@external(wasm, "emela:runtime/http@0.1.0", "finish-draft")
fn host_finish(draft: Draft) -> Outgoing use {}
