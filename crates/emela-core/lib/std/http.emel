# The Http effect (a client), its handlers and the functions over `send` (the platform and test
# layers of spec 15.2), and the entry adapter `serve` of HTTP services (`[lib.http-service]`).
#
# Use it as `Http.get(url)` and provide it with `with SystemHttp { ... }`, or with
# `with Platform { ... }` from `Std.Platform`. Requests and responses are values in
# `Std.Http.Request` and `Std.Http.Response`, so building a request is an ordinary function that
# tests can call without a handler.

import Std.State.{State}
import Std.Http.Request.{Request, Method, Get, Head, Post, Put, Patch, Delete, Options}
import Std.Http.Response.{Response, UnexpectedStatus}

## The URL cannot be read as a URL.
pub error InvalidUrl(url: String) derive Show
## No response was received (name resolution, connection, TLS, too many redirects). `message` says why.
pub error ConnectionFailed(url: String, message: String) derive Show
## The response body is not valid UTF-8.
pub error ResponseNotText(url: String) derive Show

## Sends requests. 4xx and 5xx are responses, not failures; fail only when no response is received.
pub effect Http {
  suspend fn send(request: Request) -> Response
    fails InvalidUrl | ConnectionFailed | ResponseNotText
}

## Sends a GET request to `url`.
pub fn get(url: String) -> Response fails InvalidUrl | ConnectionFailed | ResponseNotText use Http {
  (use Http).send(Request.new(Get, url))
}

## Sends a POST request to `url` with `body`.
pub fn post(url: String, body: String) -> Response
  fails InvalidUrl | ConnectionFailed | ResponseNotText
  use Http {
  (use Http).send(Request(body:, ..Request.new(Post, url)))
}

## A request with no headers and an empty body.
@deprecated("use `Request.new` of `Std.Http.Request`")
pub fn request(method: Method, url: String) -> Request {
  Request.new(method, url)
}

## Adds a header after the ones already in `req`.
@deprecated("use `Request.add_header` of `Std.Http.Request`")
pub fn add_header(req: Request, name: String, value: String) -> Request {
  Request.add_header(req, name, value)
}

## The first value of the header `name`, compared without case.
@deprecated("use `Response.header` of `Std.Http.Response`")
pub fn header(res: Response, name: String) -> Option[String] {
  Response.header(res, name)
}

## All values of the header `name` in order, compared without case.
@deprecated("use `Response.headers` of `Std.Http.Response`")
pub fn headers(res: Response, name: String) -> List[String] {
  Response.headers(res, name)
}

## The query string of `pairs`, each part percent-encoded (`q=%E6%9D%B1&page=2`).
@deprecated("use `Request.encode_query` of `Std.Http.Request`")
pub fn encode_query(pairs: List[(String, String)]) -> String {
  Request.encode_query(pairs)
}

## `res` if its status is 2xx, otherwise fails with UnexpectedStatus.
@deprecated("use `Response.require_ok` of `Std.Http.Response`")
pub fn require_ok(res: Response) -> Response fails UnexpectedStatus {
  Response.require_ok(res)
}

## A response with no headers.
@deprecated("use `Response.new` of `Std.Http.Response`")
pub fn response(status: Int, body: String) -> Response {
  Response.new(status, body)
}

## The request being built on the host (a JS object). `List` cannot cross the external function
## boundary (spec 12.4), so the headers are added one by one.
@external
type HostRequest

## The outcome of a send on the host: a response, or the kind of failure and its message.
@external
type HostResponse

@external(js, "./http.mjs", "newRequest")
fn host_request(method: String, url: String, body: String) -> HostRequest

@external(js, "./http.mjs", "withHeader")
fn host_with_header(req: HostRequest, name: String, value: String) -> HostRequest

@external(js, "./http.mjs", "send")
suspend fn host_send(req: HostRequest) -> HostResponse

## 0 for a response, 1 for InvalidUrl, 2 for ConnectionFailed, 3 for ResponseNotText.
@external(js, "./http.mjs", "outcome")
fn host_outcome(res: HostResponse) -> Int

@external(js, "./http.mjs", "message")
fn host_message(res: HostResponse) -> String

@external(js, "./http.mjs", "status")
fn host_status(res: HostResponse) -> Int

@external(js, "./http.mjs", "body")
fn host_body(res: HostResponse) -> String

@external(js, "./http.mjs", "headerCount")
fn host_header_count(res: HostResponse) -> Int

@external(js, "./http.mjs", "headerName")
fn host_header_name(res: HostResponse, index: Int) -> String

@external(js, "./http.mjs", "headerValue")
fn host_header_value(res: HostResponse, index: Int) -> String

fn method_name(method: Method) -> String {
  method match {
    Get     -> "GET"
    Head    -> "HEAD"
    Post    -> "POST"
    Put     -> "PUT"
    Patch   -> "PATCH"
    Delete  -> "DELETE"
    Options -> "OPTIONS"
  }
}

## The host's HTTP client (JS `fetch`). It follows redirects, keeps no cookies and ignores the
## proxy environment variables. Interrupting the fiber waiting on `send` aborts the request
## (spec 12.2).
pub handler SystemHttp: Http {
  suspend fn send(request, resume) {
    start = host_request(method_name(request.method), request.url, request.body)
    req = List.fold(request.headers, from: start, f: fn(req, (name, value)) {
      host_with_header(req, name, value)
    })
    res = host_send(req)
    host_outcome(res) match {
      1 -> fail InvalidUrl(url: request.url)
      2 -> fail ConnectionFailed(url: request.url, message: host_message(res))
      3 -> fail ResponseNotText(url: request.url)
      _ -> {
        headers = List.map(List.range(0, host_header_count(res)), fn(i) {
          (host_header_name(res, i), host_header_value(res, i))
        })
        resume(Response(status: host_status(res), headers:, body: host_body(res)))
      }
    }
  }
}

## The server that TestHttp sends to. `respond` gets the request and how many requests were sent
## before it (from 0), and returns the response, or `None` for ConnectionFailed. `sent` holds the
## sent requests in order.
pub type TestServer(respond: fn(Request, Int) -> Option[Response], sent: List[Request])

## The test handler. The server is `State[TestServer]`, so use it inside `State.run`:
##
## ```emela
## server = TestServer(respond: fn(req, n) { Some(Response.new(200, "ok")) }, sent: [])
## (res, after) = State.run(server, fn() { with TestHttp { Http.get("https://example.com") } })
## ```
##
## `send` adds the request to `sent` and resumes at once. It never fails with InvalidUrl or
## ResponseNotText.
pub handler TestHttp: Http {
  suspend fn send(request, resume) {
    st = use State[TestServer]
    server = st.get()
    st.set(TestServer(sent: List.append(server.sent, [request]), ..server))
    respond = server.respond
    respond(request, List.length(server.sent)) match {
      Some(res) -> resume(res)
      None -> fail ConnectionFailed(url: request.url, message: "TestServer returned no response")
    }
  }
}
