# The layer of the System handlers that every host has (`[lib.layers]`, `[api.std.platform]`).
# `main` usually runs inside `with Platform { ... }`; to replace some of them, list the
# replacements after it (`with Platform, TestClock { ... }`). It requires no host effect other than
# Async, so it can be written in `main`, a test, an exported fn and a page. The handlers that need
# a process are in the layer `Process` of `Std.Process`.

import Std.Clock.{SystemClock}
import Std.Console.{SystemConsole}
import Std.Http.{SystemHttp}
import Std.Random.{SystemRandom}

## The System handlers that every host has: SystemConsole, SystemClock, SystemRandom and
## SystemHttp. Requires no host effect other than Async. To replace some of them, list the
## replacements after it, as in `with Platform, TestClock { ... }`.
pub layer Platform {
  SystemConsole
  SystemClock
  SystemRandom
  SystemHttp
}
