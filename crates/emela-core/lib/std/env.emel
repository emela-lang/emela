# The Env effect and its handler (the platform layer of spec 15.2).
#
# The host gives presence and value as two functions. That keeps the host side simpler than an
# `@external type` holding both. Nothing changes the environment between the two calls: core has
# no way to write `process.env`.

pub effect Env {
  ## `None` if the variable is not set.
  fn get(name: String) -> Option[String]
}

@external(js, "./env.mjs", "has")
@external(c, "./env.c", "emela_env_has")
@external(wasm, "wasi:cli/environment@0.3.0", "get-environment")
fn env_has(name: String) -> Bool

@external(js, "./env.mjs", "get")
@external(c, "./env.c", "emela_env_get")
@external(wasm, "wasi:cli/environment@0.3.0", "get-environment")
fn env_get(name: String) -> String

## The host's environment variables (JS `process.env`, C `getenv`). `Option[String]` cannot cross the external
## function boundary (spec 12.4), so the host returns presence and value separately.
pub handler SystemEnv: Env {
  fn get(name) {
    if env_has(name) { Some(env_get(name)) } else { None }
  }
}
