# The Env effect and its handler (the platform layer of spec 15.2).

pub effect Env {
  ## `None` if the variable is not set.
  fn get(name: String) -> Option[String]
}

@external(js, "./env.mjs", "has")
fn env_has(name: String) -> Bool

@external(js, "./env.mjs", "get")
fn env_get(name: String) -> String

## The host's environment variables (JS `process.env`). `Option[String]` cannot cross the external
## function boundary (spec 12.4), so the host returns presence and value separately.
pub handler SystemEnv implements Env {
  fn get(name) {
    if env_has(name) { Some(env_get(name)) } else { None }
  }
}
