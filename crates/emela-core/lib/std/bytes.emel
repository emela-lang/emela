# Immutable sequences of bytes (`[api.std.bytes]`). Each byte is an `Int` from 0 to 255.
#
# `Bytes` is a built-in type: `@intrinsic` on the declaration names the type the runtime
# represents, so a user's own type named `Bytes` stays a different type. Its values are made only
# by the functions here.
#
# The intrinsics are the operations that need the representation: building from and reading out
# the bytes, slicing, joining, and the step between text and bytes. The rest is written in Emela
# over them, so it behaves the same on every target: the UTF-8 validation of `decode_utf8`
# (Unicode 17.0, Table 3-7), the hexadecimal digits, and the impls. Loops are self tail calls
# (spec 6.8), so long sequences do not use the stack.

## An immutable sequence of bytes.
@intrinsic
pub opaque type Bytes

## The sequence of no bytes.
pub fn empty() -> Bytes {
  concat([])
}

## The bytes in the order of `xs`. `None` if an element is outside 0 to 255.
@intrinsic
pub fn from_list(xs: List[Int]) -> Option[Bytes]

## The bytes in order.
@intrinsic
pub fn to_list(b: Bytes) -> List[Int]

## The number of bytes.
@intrinsic
pub fn size(b: Bytes) -> Int

pub fn is_empty(b: Bytes) -> Bool {
  size(b) == 0
}

## The byte at `index` (0-based). `None` if out of range or negative.
@intrinsic
pub fn get(b: Bytes, index: Int) -> Option[Int]

## The bytes from `from` inclusive to `to` exclusive. Both are clamped to 0 to `size(b)`; empty
## if `from` is not less than `to`.
@intrinsic
pub fn slice(b: Bytes, from: Int, to: Int) -> Bytes

## The bytes of `a`, then those of `b`.
pub fn append(a: Bytes, b: Bytes) -> Bytes {
  concat([a, b])
}

## The bytes of all of them in order.
@intrinsic
pub fn concat(parts: List[Bytes]) -> Bytes

## The UTF-8 encoding of `s`. No BOM is added.
@intrinsic
pub fn encode_utf8(s: String) -> Bytes

## The string that `b` encodes in UTF-8. `None` if `b` is not valid UTF-8. A leading BOM is kept
## as U+FEFF.
pub fn decode_utf8(b: Bytes) -> Option[String] {
  if valid_utf8_from(b, 0) { Some(decode_valid_utf8(b)) } else { None }
}

# The string of bytes already checked to be valid UTF-8.
@intrinsic
fn decode_valid_utf8(b: Bytes) -> String

fn valid_utf8_from(b: Bytes, i: Int) -> Bool {
  get(b, i) match {
    None -> True
    Some(lead) -> {
      n = sequence_size(b, i, lead)
      if n == 0 { False } else { valid_utf8_from(b, i + n) }
    }
  }
}

# The size of the well-formed sequence that starts with `lead` at `i`, or 0 if there is none. The
# ranges of the second byte leave out overlong encodings (after E0 and F0), surrogates (after ED)
# and values above U+10FFFF (after F4).
fn sequence_size(b: Bytes, i: Int, lead: Int) -> Int {
  if lead < 0x80 {
    1
  } else if lead < 0xC2 {
    0
  } else if lead < 0xE0 {
    if continues(b, i + 1, 0x80, 0xBF) { 2 } else { 0 }
  } else if lead < 0xF0 {
    low = if lead == 0xE0 { 0xA0 } else { 0x80 }
    high = if lead == 0xED { 0x9F } else { 0xBF }
    if continues(b, i + 1, low, high) && continues(b, i + 2, 0x80, 0xBF) { 3 } else { 0 }
  } else if lead < 0xF5 {
    low = if lead == 0xF0 { 0x90 } else { 0x80 }
    high = if lead == 0xF4 { 0x8F } else { 0xBF }
    if continues(b, i + 1, low, high)
      && continues(b, i + 2, 0x80, 0xBF)
      && continues(b, i + 3, 0x80, 0xBF) {
      4
    } else {
      0
    }
  } else {
    0
  }
}

fn continues(b: Bytes, i: Int, low: Int, high: Int) -> Bool {
  get(b, i) match {
    Some(x) -> x >= low && x <= high
    None    -> False
  }
}

## Two lowercase hexadecimal digits per byte, with no separator (`"89504e47"`).
pub fn to_hex(b: Bytes) -> String {
  String.concat(List.map(to_list(b), fn(x) { "#{hex_digit(x / 16)}#{hex_digit(x % 16)}" }))
}

fn hex_digit(n: Int) -> String {
  Option.or(String.from_code_point(if n < 10 { 0x30 + n } else { 0x61 + n - 10 }), "")
}

## The inverse of `to_hex`. Accepts uppercase and lowercase digits. `None` for an odd number of
## digits or any other character, including whitespace.
pub fn from_hex(s: String) -> Option[Bytes] {
  from_hex_digits(String.code_points(s), [])
}

# `acc` holds the bytes read so far, last first.
fn from_hex_digits(digits: List[Int], acc: List[Int]) -> Option[Bytes] {
  digits match {
    [] -> from_list(List.reverse(acc))
    [hi, lo, ..rest] -> (hex_value(hi), hex_value(lo)) match {
      (Some(h), Some(l)) -> from_hex_digits(rest, [h * 16 + l, ..acc])
      _                  -> None
    }
    _  -> None
  }
}

fn hex_value(c: Int) -> Option[Int] {
  if c >= 0x30 && c <= 0x39 {
    Some(c - 0x30)
  } else if c >= 0x61 && c <= 0x66 {
    Some(c - 0x61 + 10)
  } else if c >= 0x41 && c <= 0x46 {
    Some(c - 0x41 + 10)
  } else {
    None
  }
}

## The bytes that `from_hex` reads from `s`. A defect if `from_hex` returns `None`. For constants
## written in the program (`const PNG_SIGNATURE = Bytes.hex("89504e47")`).
pub fn hex(s: String) -> Bytes {
  from_hex(s) match {
    Some(b) -> b
    None    -> panic("Bytes.hex was given a string that is not hexadecimal: #{inspect(s)}")
  }
}

# Eq and Ord walk the bytes through `compare_from`, a self tail call; a call through a trait
# function would not be one.

## The same bytes in the same order.
impl Bytes: Eq {
  fn eq(self, other) { size(self) == size(other) && compare_from(self, other, 0) == Equal }
}

## Lexicographic on the bytes as unsigned values; if the common prefix is equal, the shorter one
## is smaller.
impl Bytes: Ord {
  fn compare(self, other) { compare_from(self, other, 0) }
}

fn compare_from(a: Bytes, b: Bytes, i: Int) -> Ordering {
  (get(a, i), get(b, i)) match {
    (Some(x), Some(y)) -> if x < y {
      Less
    } else if x > y {
      Greater
    } else {
      compare_from(a, b, i + 1)
    }
    (Some(_), None) -> Greater
    (None, Some(_)) -> Less
    (None, None)    -> Equal
  }
}

## The source form `Bytes.hex("89504e47")`, which can be pasted back as an expression.
impl Bytes: Show {
  fn show(self) { "Bytes.hex(#{inspect(to_hex(self))})" }
}
