import Std.Test.Gen.{Gen, Tree}
import Std.Fiber.{Success, Failure}
import Std.Cause

## Reproducible settings. max_size is in 0..1000; shrink_limit counts candidate evaluations.
pub type Config(seed: Int, cases: Int, max_size: Int, shrink_limit: Int)

## Fixed defaults; use record update to override individual fields.
pub fn config() -> Config {
  Config(seed: 20261013, cases: 100, max_size: 100, shrink_limit: 1000)
}

## Runs assertions on generated inputs. Errors and defects count as failures, not interruptions.
pub fn check[A, E, R](gen: Gen[A], f: fn(A) -> () fails E use R) -> () use R {
  check_with(gen, config(), f)
}

pub fn check_with[A, E, R](gen: Gen[A], config: Config, f: fn(A) -> () fails E use R) -> () use R {
  if config.cases <= 0 || config.max_size < 0 || config.max_size > 1000 || config.shrink_limit < 0 {
    panic("Property: invalid config (cases > 0, max_size in 0..1000, shrink_limit >= 0 required)")
  }
  run_cases(gen, config, f, config.seed, 0)
}

fn context(config: Config, seed: Int, index: Int, size: Int) -> String {
  "seed=#{config.seed} case=#{index} case_seed=#{seed} size=#{size}"
}

fn run_cases[A, E, R](
  gen: Gen[A],
  config: Config,
  f: fn(A) -> () fails E use R,
  seed: Int,
  index: Int,
) -> () use R {
  if index < config.cases {
    size = index % (config.max_size + 1)
    info = context(config, seed, index, size)
    (tree, rest) = Fiber.attempt(fn() { Gen.sample(gen, seed, size) }) match {
      Success(value) -> value
      Failure(cause) -> panic("Property generator failed (#{info}): #{Cause.to_string(cause)}")
    }
    Fiber.attempt(fn() { f(tree.value) }) match {
      Success(_) -> run_cases(gen, config, f, rest, index + 1)
      Failure(cause) -> {
        (smallest, reason, tried) = shrink(
          tree,
          Cause.to_string(cause),
          f,
          config.shrink_limit,
          0,
          info,
        )
        panic(
          "Property failed (#{info})\noriginal: #{tree.value}\ncounterexample: #{smallest.value}\nshrink_attempts=#{tried} limit=#{config.shrink_limit}\n#{reason}",
        )
      }
    }
  }
}

fn shrink[A, E, R](
  tree: Tree[A],
  reason: String,
  f: fn(A) -> () fails E use R,
  budget: Int,
  tried: Int,
  info: String,
) -> (Tree[A], String, Int) use R {
  if budget == 0 {
    (tree, reason, tried)
  } else {
    children = Fiber.attempt(fn() { (tree.children)() }) match {
      Success(value) -> value
      Failure(cause) -> panic(
        "Property generator failed during shrinking (#{info}): #{Cause.to_string(cause)}",
      )
    }
    search(children, tree, reason, f, budget, tried, info)
  }
}

fn search[A, E, R](
  children: List[Tree[A]],
  best: Tree[A],
  reason: String,
  f: fn(A) -> () fails E use R,
  budget: Int,
  tried: Int,
  info: String,
) -> (Tree[A], String, Int) use R {
  if budget == 0 {
    (best, reason, tried)
  } else {
    children match {
      [] -> (best, reason, tried)
      [child, ..rest] -> Fiber.attempt(fn() { f(child.value) }) match {
        Success(_)     -> search(rest, best, reason, f, budget - 1, tried + 1, info)
        Failure(cause) -> shrink(child, Cause.to_string(cause), f, budget - 1, tried + 1, info)
      }
    }
  }
}
