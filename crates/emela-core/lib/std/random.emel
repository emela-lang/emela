# The Random effect and its handler (the platform layer of spec 15.2).

pub effect Random {
  ## Uniform over the whole range of Int.
  fn int() -> Int
  ## Uniform in [0, 1).
  fn float() -> Float
}

@external(js, "./random.mjs", "int")
@external(c, "./random.c", "emela_random_int")
fn random_int() -> Int

@external(js, "./random.mjs", "float")
@external(c, "./random.c", "emela_random_float")
fn random_float() -> Float

## The host's random source (JS `crypto.getRandomValues`, C `arc4random_buf` or `getrandom`;
## cryptographically secure). Stateless.
pub handler SystemRandom: Random {
  fn int() { random_int() }
  fn float() { random_float() }
}
