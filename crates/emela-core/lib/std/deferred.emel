# Deferred (`[task.deferred]`): a box that takes a value only once, for passing values between
# tasks.
#
# `with d = Deferred` makes an empty box, and `d` is its capability:
#
#   with ready = Deferred, tasks = Task.Group {
#     tasks.start(|| serve(ready))
#     port = ready.await()
#   }
#
# The effect and the handler are built in: the runtime holds the box. Lowering turns the handler
# into a handler value whose operations are concurrency operations of the Core IR.

## A box for one value of type `A`. dbg shows the capability as `<deferred>`.
@intrinsic
pub effect Deferred[A] {
  ## Puts `value` in the box and returns True the first time. Afterwards does nothing and returns
  ## False. Does not suspend.
  fn complete(value: A) -> Bool
  ## Waits until the box has a value, and returns it. Any number of tasks may wait on one box.
  suspend fn await() -> A
  ## The value if the box has one, `None` otherwise. Does not wait or suspend.
  fn poll() -> Option[A]
}

## Makes an empty box. Its release does nothing.
@intrinsic
pub handler Deferred[A]: Deferred[A]
