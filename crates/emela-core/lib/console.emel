# The Console effect (the platform layer of spec 15.2). Only the declaration lives here; handlers
# live in per-target modules (`JsConsole` for JS).
#
# Use it as `(use Console).print_line("hi")` and provide it with `with JsConsole { ... }` in `main`
# or similar.

## Writes a line to standard output (`print_line`) or standard error (`print_error_line`).
pub effect Console {
  fn print_line(text: String) -> ()
  fn print_error_line(text: String) -> ()
}
