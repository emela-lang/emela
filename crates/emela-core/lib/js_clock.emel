# The JS handler for Clock (spec 8.4, 15.2). Stateless.
# `sleep` calls `resume` later from a timer callback, so JsClock depends on Async (spec 8.7).

import Clock.{Clock}

@external(js, "./js_clock.mjs", "nowMilliseconds")
fn now_milliseconds() -> Int64

@external(js, "./js_clock.mjs", "after")
fn after(ms: Int, f: fn() -> ()) -> ()

## `sleep` uses JS `setTimeout`; `now` uses `Date.now()` (milliseconds since the Unix epoch).
pub handler JsClock implements Clock {
  suspend fn sleep(ms, resume) { after(ms, fn() { resume(()) }) }
  fn now() { Instant.from_unix_milliseconds(now_milliseconds()) }
}
