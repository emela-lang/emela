# The test handler for Console (spec 8.8, 15.2). It keeps the printed lines in
# `State[List[String]]`, so use it inside `State.run`:
#
#   (_, lines) = State.run([], fn() { with TestConsole { greet(1) } })
#   assert lines == ["Hello, alice!"]

import Console.{Console}
import State.{State}

## `print_line` appends the line to `State[List[String]]` in the printed order.
## `print_error_line` drops the line.
pub handler TestConsole implements Console {
  fn print_line(text) {
    (use State[List[String]]).update(fn(lines) { List.append(lines, [text]) })
  }
  fn print_error_line(text) { () }
}
