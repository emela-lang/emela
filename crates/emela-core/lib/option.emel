# Option の関数．Option 自体は Prelude の enum（prelude.emel）．
# 対象の Option を第1引数 `opt` に置く（`opt |> Option.map(f)` と書けるように）．
#
# `Option.or_fail(opt, err)`（`None` なら fail する）は，型推論が fail を扱えるまで
# `staged/option_or_fail.emel` に置いて同梱の読み込みから外している（NOTES.md の「保留中のソース」）．

## 中身に `f` を適用する．`None` は `None` のまま．
pub fn map[A, B](opt: Option[A], f: fn(A) -> B) -> Option[B] {
  match opt {
    Some(x) -> Some(f(x))
    None -> None
  }
}

## 中身に Option を返す `f` を適用して平らにする．
pub fn and_then[A, B](opt: Option[A], f: fn(A) -> Option[B]) -> Option[B] {
  match opt {
    Some(x) -> f(x)
    None -> None
  }
}

## 中身か，`None` なら `default`．
pub fn unwrap_or[A](opt: Option[A], default: A) -> A {
  match opt {
    Some(x) -> x
    None -> default
  }
}

## `Some` か．
pub fn is_some[A](opt: Option[A]) -> Bool {
  match opt {
    Some(_) -> True
    None -> False
  }
}

## `None` か．
pub fn is_none[A](opt: Option[A]) -> Bool {
  match opt {
    Some(_) -> False
    None -> True
  }
}
