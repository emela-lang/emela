fn JsClock() {
  handler JsClock: Clock {
    sleep: fn(ms%49, resume%50) {
      after(ms%49, fn() {
        (resume%50)(ms%49)
      })
    }
    now: fn() {
      0
    }
  }
}

suspend fn naps(xs%32, ev%33) {
  let clock%34 = use[Clock](ev%33)
  List.map$suspend8(xs%32, suspend fn(ms%35, ev%36) {
    (clock%34.Clock#sleep(ms%35)! +[Int] clock%34.Clock#now())
  }, ev%33)!
}

fn InstantClock() {
  handler InstantClock: Clock {
    sleep: fn(ms%30, resume%31) {
      (resume%31)(0)
    }
    now: fn() {
      0
    }
  }
}

fn FetchingClock() {
  handler FetchingClock: Clock {
    sleep: suspend fn(ms%27, resume%28) {
      (resume%28)(@String.length(fetch_text("x")!))
    }
    now: fn() {
      0
    }
  }
}

fn List.map(xs%10, f%11, ev%12) {
  List.reverse(List.fold(xs%10, [], fn(acc%13, x%14, ev%15) {
    [(f%11)(x%14, ev%15)?, ..acc%13]
