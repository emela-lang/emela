fn Shape: Ord.compare(self%0: Shape, other%1: Shape) -> Prelude.Ordering {
  let tag%2: Int = match self%0 {
    Shape.Dot -> 0
    Shape.Line(_, _) -> 1
  }
  let tag%3: Int = match other%1 {
    Shape.Dot -> 0
    Shape.Line(_, _) -> 1
  }
  if (tag%2 <[Int] tag%3) {
    Prelude.Ordering.Less
  } else {
    if (tag%3 <[Int] tag%2) {
      Prelude.Ordering.Greater
    } else {
      match self%0 {
        Shape.Dot -> match other%1 {
          Shape.Dot -> Prelude.Ordering.Equal
          _ -> Prelude.Ordering.Equal
        }
        Shape.Line(x%4, x%5) -> match other%1 {
          Shape.Line(y%6, y%7) -> match Point: Ord.compare(x%4, y%6) {
            Prelude.Ordering.Equal -> Point: Ord.compare(x%5, y%7)
            o%8 -> o%8
          }
          _ -> Prelude.Ordering.Equal
        }
      }
    }
  }
}

fn Point: Ord.compare(self%0: Point, other%1: Point) -> Prelude.Ordering {
  match self%0 {
    Point.Point(x: x%2, y: x%3) -> match other%1 {
      Point.Point(x: y%4, y: y%5) -> match if (x%2 <[Int] y%4) {
