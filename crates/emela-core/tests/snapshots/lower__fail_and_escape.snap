error enum NotFound {
  NotFound(id: Int)
}

error enum Unauthorized {
  Unauthorized
}

error enum Prelude.ParseError {
  ParseError(input: String)
}

error enum Std.Http.InvalidUrl {
  InvalidUrl(url: String)
}

error enum Std.Http.ConnectionFailed {
  ConnectionFailed(url: String, message: String)
}

error enum Std.Http.ResponseNotText {
  ResponseNotText(url: String)
}

error enum Std.Http.UnexpectedStatus {
  UnexpectedStatus(status: Int, body: String)
}

error enum Std.FileSystem.FileNotFound {
  FileNotFound(path: String)
}

error enum Std.FileSystem.FileAccessDenied {
  FileAccessDenied(path: String)
}

error enum Std.FileSystem.NotADirectory {
  NotADirectory(path: String)
}

error enum Std.FileSystem.IsADirectory {
  IsADirectory(path: String)
}

error enum Std.FileSystem.DirectoryNotEmpty {
  DirectoryNotEmpty(path: String)
}

error enum Std.FileSystem.InvalidText {
  InvalidText(path: String)
}

error enum Std.FileSystem.FileSystemFailure {
