}

export fn main() -> Int fails {
  let a%1: Int = {
    find(1)?
  } escape {
    NotFound.NotFound(id: id%0) if (id%0 >[Int] 5) -> id%0
    Unauthorized.Unauthorized -> fail NotFound.NotFound(id: 0)
  }
  let b%2: Int = Option.or_fail[Int, Unauthorized](Option.Some[Int](1), Unauthorized.Unauthorized)?
  let c%3: Int = (pure(a%1) +[Int] b%2)
  @dbg[Int](c%3)
}

fn find(id%70: Int) -> Int fails {
  if (id%70 >[Int] 0) {
    id%70
  } else {
    if (id%70 ==[Int] 0) {
      fail NotFound.NotFound(id: id%70)
    } else {
      fail Unauthorized.Unauthorized
    }
  }
}

fn pure(n%4: Int) -> Int {
  (n%4 +[Int] 1)
}
