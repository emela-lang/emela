export fn main() {
  let a%1 = {
    find(1)?
  } escape {
    NotFound.NotFound(id: id%0) if (id%0 >[Int] 5) -> id%0
    Unauthorized.Unauthorized -> fail NotFound.NotFound(id: 0)
