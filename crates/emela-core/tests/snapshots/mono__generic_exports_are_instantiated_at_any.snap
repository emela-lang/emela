export fn main() -> Int {
  @dbg[Int](count[()](1))
}

export fn count(n%0: Int) -> Int {
  let xs%2: List[any] = []: List[any]
  (n%0 +[Int] List.length[any](xs%2))
}

fn count[()](n%1: Int) -> Int {
  let xs%4: List[()] = []: List[()]
  (n%1 +[Int] List.length[()](xs%4))
}
