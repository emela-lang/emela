effect Clock {
  fn now() -> Int
}

effect Stamp {
  fn stamp(String) -> String fails
}

export fn main() -> Int {
  with {
    let h%0: handler Clock = Fixed()
    let h%1: handler Stamp = ClockStamp(provide(; Clock = h%0))
    let ev%2: evidence = provide(; Clock = h%0 Stamp = h%1)
  } {
    let clock%3: handler Clock = h%0
    let _%4: String = @dbg[String]({
      stamped("a", ev%2)?
    } escape {
      Late.Late -> "late"
    })
    let _%6: Int = @dbg[Int](apply[{}, {ev}](fn(ev%5: evidence) -> Int {
      (clock%3.Clock#now() +[Int] (use[Clock](ev%5)).Clock#now())
    }, ev%2))
    let _%9: List[Int] = @dbg[List[Int]](List.map[Int, Int, {}, {ev}]([1]: List[Int], fn(x%7: Int, ev%8: evidence) -> Int {
      (x%7 +[Int] (use[Clock](ev%8)).Clock#now())
    }, ev%2))
    let f%12: fn() -> Int ev = {
      let h%11: handler Clock = clock%3
      fn(ev%10: evidence) -> Int {
        h%11.Clock#now()
      }
    }
    @dbg[Int]((f%12)(ev%2))
  }
}

fn Fixed() -> handler Clock {
  handler Fixed: Clock {
    now: fn() -> Int {
      42
    }
  }
}

fn ClockStamp(ev%94: evidence) -> handler Stamp {
  handler ClockStamp: Stamp {
    stamp: fn(s%95: String) -> String fails {
      let t%96: Int = (use[Clock](ev%94)).Clock#now()
      let _%97: () = if (t%96 >[Int] 100) {
        fail Late.Late
      } else {
        ()
      }
      concat(s%95 as String, "@", t%96 as Int)
    }
  }
}

fn stamped(s%92: String, ev%93: evidence) -> String fails {
  (use[Stamp](ev%93)).Stamp#stamp(s%92)?
}
