---
source: crates/emela-core/tests/lower.rs
expression: "mine.join(\"\\n\\n\")"
---
effect Clock {
  fn now() -> Int
}

effect Stamp {
  fn stamp(String) -> String fails
}

export fn main() -> Int {
  with {
    let h%0: handler Clock = Fixed()
    let h%1: handler Stamp = ClockStamp(provide(; Clock = h%0))
    let ev%2: evidence = provide(; Clock = h%0 Stamp = h%1)
  } {
    let clock%3: handler Clock = h%0
    let _%4: String = @dbg[String]({
      stamped("a", ev%2)?
    } escape {
      Late.Late -> "late"
    })
    let _%5: Int = @dbg[Int](apply[{}, {ev}](fn(ev%6: evidence) -> Int {
      (clock%3.Clock#now() +[Int] (use[Clock](ev%6)).Clock#now())
    }, ev%2))
    let _%7: List[Int] = @dbg[List[Int]](List.map[Int, Int, {}, {ev}]([1]: List[Int], fn(x%8: Int, ev%9: evidence) -> Int {
      (x%8 +[Int] (use[Clock](ev%9)).Clock#now())
    }, ev%2))
    let f%10: fn() -> Int ev = {
      let h%11: handler Clock = clock%3
      fn(ev%12: evidence) -> Int {
        h%11.Clock#now()
      }
    }
    @dbg[Int]((f%10)(ev%2))
  }
}

fn Fixed() -> handler Clock {
  handler Fixed: Clock {
    now: fn() -> Int {
      42
    }
  }
}

fn ClockStamp(ev%0: evidence) -> handler Stamp {
  handler ClockStamp: Stamp {
    stamp: fn(s%1: String) -> String fails {
      let t%2: Int = (use[Clock](ev%0)).Clock#now()
      let _%3: () = if (t%2 >[Int] 100) {
        fail Late.Late
      } else {
        ()
      }
      concat(s%1 as String, "@", t%2 as Int)
    }
  }
}

fn stamped(s%0: String, ev%1: evidence) -> String fails {
  (use[Stamp](ev%1)).Stamp#stamp(s%0)?
}
