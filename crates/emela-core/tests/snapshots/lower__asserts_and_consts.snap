---
source: crates/emela-core/tests/lower.rs
expression: "mine.join(\"\\n\\n\")"
---
export fn main() -> () {
  let _%0: () = assert(LIMIT() ==[Int] 3, ty: Int, text: "LIMIT == 3", at: "src/main.emel:6:3")
  let _%1: () = assert({
    let n%172: Int = 2
    match n%172 {
      c%173 if (c%173 ==[Int] LIMIT()) -> "limit"
      0 -> "zero"
      m%174 if (m%174 >[Int] 100) -> "big"
      _ -> "other"
    }
  } !=[String] "big", ty: String, text: "classify(2) != \"big\"", at: "src/main.emel:7:3")
  let _%2: () = assert(ORIGIN() ==[Structural] (0, 0), ty: (Int, Int), text: "ORIGIN == (0, 0)", at: "src/main.emel:8:3")
  let _%3: () = assert(List.length[()](EMPTY[()]()) ==[Int] 0, ty: Int, text: "List.length(EMPTY) == 0", at: "src/main.emel:9:3")
  let _%4: () = assert({
    let a%175: Int = 1
    let b%176: Int = 1
    let _%177: () = assert(a%175 ==[Structural] b%176, ty: Int, text: "a == b", at: "src/main.emel:24:3")
    true
  }, text: "same(1, 1)", at: "src/main.emel:10:3")
  assert({
    let n%178: Int = LIMIT()
    (n%178 <[Int] (LIMIT() +[Int] 1))
  }, text: "is_small(LIMIT)", at: "src/main.emel:11:3")
}

const fn LIMIT() -> Int {
  3
}

fn classify(n%120: Int) -> String {
  match n%120 {
    c%121 if (c%121 ==[Int] LIMIT()) -> "limit"
    0 -> "zero"
    m%122 if (m%122 >[Int] 100) -> "big"
    _ -> "other"
  }
}

const fn ORIGIN() -> (Int, Int) {
  (0, 0)
}
