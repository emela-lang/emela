export fn main() -> String {
  let u%0: User = User.User(id: 1, name: "a", tags: []: List[String])
  let renamed%1: User = {
    let arg%2: List[String] = ["x"]: List[String]
    let arg%3: String = @String.append(u%0.name#1, "!")
    let base%4: User = u%0
    User.User(id: base%4.id#0, name: arg%3, tags: arg%2)
  }
  let p%5: Pair[Int, Bool] = Pair.Pair[Int, Bool](first: 1, second: true)
  let q%6: Pair[String, Bool] = {
    let base%7: Pair[Int, Bool] = p%5
    Pair.Pair[String, Bool](first: "s", second: base%7.second#1)
  }
  concat(renamed%1.name#1 as String, " has ", renamed%1.tags#2 as List[String], " and ", q%6 as Pair[String, Bool], ", id ", u%0.id#0 as Int)
}
