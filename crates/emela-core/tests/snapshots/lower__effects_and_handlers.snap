---
source: crates/emela-core/tests/lower.rs
expression: "mine.join(\"\\n\\n\")"
---
effect Clock {
  fn now() -> Int
}

effect Stamp {
  fn stamp(String) -> String fails
}

export fn main() -> Int {
  with {
    let h%0: handler Clock = Fixed()
    let h%1: handler Stamp = ClockStamp(provide(; Clock = h%0))
    let ev%2: evidence = provide(; Clock = h%0 Stamp = h%1)
  } {
    let clock%3: handler Clock = h%0
    let _%4: String = @dbg[String]({
      stamped("a", ev%2)?
    } escape {
      Late.Late -> "late"
    })
    let _%7: Int = @dbg[Int](apply[{}, {ev}](fn(ev%5: evidence) -> Int {
      (clock%3.Clock#now() +[Int] h%0.Clock#now())
    }, ev%2))
    let _%11: List[Int] = @dbg[List[Int]](List.map[Int, Int, {}, {ev}]([1]: List[Int], fn(x%8: Int, ev%9: evidence) -> Int {
      (x%8 +[Int] h%0.Clock#now())
    }, ev%2))
    let f%14: fn() -> Int ev = {
      let h%12: handler Clock = clock%3
      fn(ev%13: evidence) -> Int {
        h%12.Clock#now()
      }
    }
    @dbg[Int]((f%14)(ev%2))
  }
}

fn Fixed() -> handler Clock {
  handler Fixed: Clock {
    now: fn() -> Int {
      42
    }
  }
}

fn ClockStamp(ev%89: evidence) -> handler Stamp {
  handler ClockStamp: Stamp {
    stamp: fn(s%90: String) -> String fails {
      let t%91: Int = (use[Clock](ev%89)).Clock#now()
      let _%92: () = if (t%91 >[Int] 100) {
        fail Late.Late
      } else {
        ()
      }
      concat(s%90 as String, "@", t%91 as Int)
    }
  }
}

fn stamped(s%87: String, ev%88: evidence) -> String fails {
  (use[Stamp](ev%88)).Stamp#stamp(s%87)?
}
