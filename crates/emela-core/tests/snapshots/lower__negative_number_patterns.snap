export fn main() -> Int {
  let _%0: Int = @dbg[Int](int((-[Int] 1)))
  let _%1: Int = @dbg[Int](long((-[Int64] 5i64)))
  @dbg[Int](float((-[Float] 0.0)))
}

fn int(n%4: Int) -> Int {
  match n%4 {
    -2147483648 -> 0
    -16 -> 1
    _ -> 2
  }
}

fn long(n%3: Int64) -> Int {
  match n%3 {
    -9223372036854775808i64 -> 0
    _ -> 1
  }
}

fn float(x%2: Float) -> Int {
  match x%2 {
    -0.0 -> 0
    -1.5 -> 1
    _ -> 2
  }
}
