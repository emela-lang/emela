enum Shape {
  Circle(Float)
  Rect(width: Float, height: Float)
  Empty
}

enum Pair[A, B] {
  Pair(first: A, second: B)
}

enum Option[A] {
  Some(A)
  None
}

enum Prelude.Ordering {
  Less
  Equal
  Greater
}

enum Std.Duration.Duration {
  Duration(milliseconds: Int64)
}

enum Std.Instant.Instant {
  Instant(milliseconds: Int64)
}

export fn main() {
  let _%0 = @dbg[Float](area(Shape.Rect(width: 3.0, height: 2.0)))
  let _%1 = @dbg[String](describe([1, 2, 3]))
  match (1, "x") {
    (a%2, b%3) -> match Pair.Pair(first: a%2, second: b%3) {
      Pair.Pair(first: _, second: second%4) -> @dbg[String](second%4)
