fn area(s%7) {
  match s%7 {
    Shape.Circle(r%8) -> ((r%8 *[Float] r%8) *[Float] 3.0)
    Shape.Rect(width: w%9, height: _) if (w%9 >[Float] 10.0) -> 0.0
    Shape.Rect(width: w%10, height: h%11) -> (w%10 *[Float] h%11)
    Shape.Empty -> 0.0
  }
}

fn describe(xs%5) {
  match xs%5 {
    [] -> "empty"
    [1, .._] -> "one first"
    [_, ..rest%6] -> if (rest%6 ==[Structural] []) {
      "single"
    } else {
      "many"
    }
  }
}
