</div>
</article>
<article class="item" id="Shape">
<div class="item-head"><h3><a href="#Shape">Shape</a></h3><span class="kind">enum</span></div>
<pre class="signature"><code><span class="kw">enum</span> <a class="ty" href="#Shape">Shape</a></code></pre>
<ul class="children">
<li id="Shape.Circle"><pre class="signature"><code><span class="ty">Circle</span>(radius: <span class="ty">Int</span>)</code></pre>
<div class="doc">
<p>A circle around the origin.</p>
</div>
</li>
<li id="Shape.Rect"><pre class="signature"><code><span class="ty">Rect</span>(<span class="ty">Int</span>, <span class="ty">Int</span>)</code></pre>
</li>
<li id="Shape.Empty"><pre class="signature"><code><span class="ty">Empty</span></code></pre>
</li>
</ul>
</article>
