<h2>Types</h2>
<article class="item" id="Point">
<div class="item-head"><h3><a href="#Point">Point</a></h3><span class="kind">type</span></div>
<pre class="signature"><code><span class="kw">type</span> <a class="ty" href="#Point">Point</a>(x: <span class="ty">Int</span>, y: <span class="ty">Int</span>)</code></pre>
<div class="doc">
<p>A point on the plane.</p>
</div>
<ul class="children">
<li id="Point.x"><pre class="signature"><code>x: <span class="ty">Int</span></code></pre>
<div class="doc">
<p>Distance from the left.</p>
</div>
</li>
<li id="Point.y"><pre class="signature"><code>y: <span class="ty">Int</span></code></pre>
</li>
</ul>
</article>
<article class="item" id="Secret">
<div class="item-head"><h3><a href="#Secret">Secret</a></h3><span class="kind">type</span></div>
