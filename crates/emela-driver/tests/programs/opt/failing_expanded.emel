# The hand-written expansion of `failing_fused.emel`: the same failing body as a
# fallible self tail call, caught with the same `escape`.

error Stop(at: Int)

fn visit(n: Int, stop: Int) -> Int {
  go(0, n, stop, 0) escape {
    Stop(at:) -> {
      dbg("stopped at #{at}")
      0 - 1
    }
  }
}

fn go(i: Int, n: Int, stop: Int, acc: Int) -> Int fails Stop {
  if i >= n {
    acc
  } else {
    if i == stop { fail Stop(at: i) }
    dbg("visit #{i}")
    go(i + 1, n, stop, acc + i)
  }
}

fn main() {
  _ = visit(5, 2)
  _ = visit(5, 9)
  _ = visit(0, 0)
  ()
}
