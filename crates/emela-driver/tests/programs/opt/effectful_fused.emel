# A mutation pair with an effectful body: the callback of a folded
# `List.range(0, n)` logs, so the range fusion rewrites this shape and the
# order of the effect operations (and therefore stderr) must survive it, both
# with optimisation on and off and with the hand-written expansion.
# `effectful_expanded.emel` is the same program with the loop written by hand.

effect Log {
  fn log(msg: String) -> ()
}

handler ConsoleLog: Log {
  fn log(msg) {
    dbg(msg)
    ()
  }
}

fn each_range(n: Int) -> () uses { Log } {
  _ = List.fold(List.range(0, n), 0, |acc, i| {
    (use Log).log("at #{i}")
    acc
  })
  ()
}

fn main() {
  with ConsoleLog {
    each_range(3)
    each_range(0)
    each_range(5)
  }
  ()
}
