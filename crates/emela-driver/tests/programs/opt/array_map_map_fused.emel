# A mutation pair for the array map∘map law (D4/PR-031): `Array.map(Array.map(a, f), g)` is the
# law's input, and `array_map_map_expanded.emel` is the same program as one hand-written pass that
# builds no intermediate array. The law is off in the default pipeline because it is new, so this
# pair checks that the two hand-written programs give the same output on every target; when the
# law is turned on, it becomes a direct check of the law's output too.
import Std.Array.{Array}

fn inc(x: Int) -> Int {
  x + 1
}

fn twice(x: Int) -> Int {
  x * 2
}

fn pipeline(a: Array[Int]) -> Array[Int] {
  Array.map(Array.map(a, inc), twice)
}

fn main() {
  dbg(pipeline(Array.from_list([1, 2, 3])))
  dbg(pipeline(Array.from_list([])))
  ()
}
