---
source: crates/emela-lir/tests/heap.rs
expression: "parts(&m, &[\"main\", \"count\"])"
---
export fn main() -> i32 (Int) defects {
  t%0: ref (String) = builtin String.append("a", "b")
  dup t%0
  f%1: ref (fn() -> Int) = make_closure main$closure0[t%0]
  dup t%0
  f%2: ref (fn() -> Int) = make_closure main$closure1[t%0]
  dup t%0
  dup t%0
  t%3: i32 (Int) = call pair(t%0, t%0)
  t%4: i32 (Int) = call host(t%0) on_defect {
    drop t%0
    drop f%1
    drop f%2
    unwind
  }
  t%5: i32 (Int) = t%3 +[i32] t%4
  t%6: i32 (Int) = call count(3, t%0)
  t%7: i32 (Int) = t%5 +[i32] t%6
  t%8: i32 (Int) = call_indirect f%1() on_defect {
    drop f%1
    drop f%2
    unwind
  }
  drop f%1
  t%9: i32 (Int) = t%7 +[i32] t%8
  t%10: i32 (Int) = call_indirect f%2() on_defect {
    drop f%2
    unwind
  }
  drop f%2
  t%11: i32 (Int) = t%9 +[i32] t%10
  return t%11
}

fn count(n%0: i32 (Int), s%1: ref (String)) -> i32 (Int) {
  t%8: i32 (Int) = loop(n%2: i32 (Int) = n%0, s%3: ref (String) = s%1) {
    t%4: i32 (Bool) = n%2 ==[i32] 0
    t%7: i32 (Int) = if t%4 {
      t%5: i32 (Int) = builtin String.length(s%3)
      drop s%3
      yield t%5
    } else {
      t%6: i32 (Int) = n%2 -[i32] 1
      recur(t%6, s%3)
    }
    yield t%7
  }
  return t%8
}

fn main$closure0(env%0: ref (fn() -> Int)) -> i32 (Int) env[String] {
  t%1: ref (String) = env_get env%0#0
  dup t%1
  t%2: i32 (Int) = builtin String.length(t%1)
  drop t%1
  return t%2
}

fn main$closure1(env%0: ref (fn() -> Int)) -> i32 (Int) env[String] {
  t%1: ref (String) = env_get env%0#0
  dup t%1
  t%2: i32 (Int) = builtin String.length(t%1)
  drop t%1
  t%3: i32 (Int) = t%2 +[i32] 1
  return t%3
}
