  nil%2: ref (List[String]) = list[]
  reversed%5: ref (List[String]) = loop(p%3: ref (List[Option[Int]]) = x%0, rev%4: ref (List[String]) = nil%2) {
    empty%6: i32 (Bool) = list_is_empty p%3
    if empty%6 {} else {
      h%7: ref (Option[Int]) = list_head p%3
      t%8: ref (List[Option[Int]]) = list_tail p%3
      s%9: ref (String) = call show$Option[Int](h%7)
      next%10: ref (List[String]) = list[s%9, ..rev%4]
      recur(t%8, next%10)
    }
