export fn main() -> i32 (Int) {
  f%0: ref (fn(Int) -> fn(Int) -> Int ev ev) = call adder(1)
  t%1: ref (evidence) = ev_extend([])
  g%2: ref (fn(Int) -> Int ev) = call_indirect f%0(2, t%1)
  t%3: ref (evidence) = ev_extend([])
  t%4: i32 (Int) = call_indirect g%2(3, t%3)
  s%5: ref (String) = builtin Int.to_string(t%4)
  runtime debug_print(s%5)
  return t%4
}

fn adder(base%0: i32 (Int)) -> ref (fn(Int) -> fn(Int) -> Int ev ev) {
  f%9: ref (fn(Int) -> fn(Int) -> Int ev ev) = closure(x%1: i32 (Int), ev%2: ref (evidence)) [base%0] {
    y%3: i32 (Int) = x%1 *[i32] 2
    f%8: ref (fn(Int) -> Int ev) = closure(z%4: i32 (Int), ev%5: ref (evidence)) [base%0, y%3] {
      t%6: i32 (Int) = base%0 +[i32] y%3
      t%7: i32 (Int) = t%6 +[i32] z%4
      return t%7
    }
    return f%8
  }
  return f%9
}
