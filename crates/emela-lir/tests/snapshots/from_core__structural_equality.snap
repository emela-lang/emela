---
source: crates/emela-lir/tests/from_core.rs
expression: "parts(&m, &[\"same\", \"main\", \"eq$\", \"show$\"])"
---
export fn main() -> void (()) {
  t%0: ref (Tree) = make Tree.Leaf
  t%1: ref (Point) = make Point.Point(1, 2)
  t%2: ref (Tree) = make Tree.Leaf
  t%3: ref (Tree) = make Tree.Node(t%0, t%1, t%2)
  _%4: i32 (Bool) = call same(t%3, t%3)
  s%5: ref (String) = if _%4 {
    yield "True"
  } else {
    yield "False"
  }
  runtime debug_print(s%5)
  t%6: ref ((Int, String)) = tuple(1, "a")
  t%7: ref (List[(Int, String)]) = list[t%6]
  t%8: ref ((Int, String)) = tuple(1, "b")
  t%9: ref (List[(Int, String)]) = list[t%8]
  eq%10: i32 (Bool) = call eq$List[(Int, String)](t%7, t%9)
  _%11: i32 (Bool) = ![i32] eq%10
  s%12: ref (String) = if _%11 {
    yield "True"
  } else {
    yield "False"
  }
  runtime debug_print(s%12)
  t%13: ref (Point) = make Point.Point(1, 2)
  t%14: ref (Point) = make Point.Point(1, 3)
  eq%15: i32 (Bool) = call eq$Point(t%13, t%14)
  if eq%15 {} else {
    s%16: ref (String) = call show$Point(t%13)
    s%17: ref (String) = call show$Point(t%14)
    s%18: ref (String) = builtin String.append("assertion failed: Point(x: 1, y: 2) == Point(x: 1, y: 3)\n  left: ", s%16)
    s%19: ref (String) = builtin String.append(s%18, "\n right: ")
    s%20: ref (String) = builtin String.append(s%19, s%17)
    defect(s%20) at "src/main.emel:18:3"
  }
  return
}

fn same(a%0: ref (Tree), b%1: ref (Tree)) -> i32 (Bool) {
  eq%2: i32 (Bool) = call eq$Tree(a%0, b%1)
  return eq%2
}

fn eq$List[(Int, String)](a%0: ref (List[(Int, String)]), b%1: ref (List[(Int, String)])) -> i32 (Bool) {
  r%4: i32 (Bool) = loop(p%2: ref (List[(Int, String)]) = a%0, q%3: ref (List[(Int, String)]) = b%1) {
    pe%5: i32 (Bool) = list_is_empty p%2
    qe%6: i32 (Bool) = list_is_empty q%3
    if pe%5 {} else {
      if qe%6 {
        return false
      } else {}
      x%7: ref ((Int, String)) = list_head p%2
      y%8: ref ((Int, String)) = list_head q%3
      eq%9: i32 (Bool) = call eq$(Int, String)(x%7, y%8)
      if eq%9 {} else {
        return false
      }
      pt%10: ref (List[(Int, String)]) = list_tail p%2
      qt%11: ref (List[(Int, String)]) = list_tail q%3
      recur(pt%10, qt%11)
    }
    yield qe%6
  }
  return r%4
}

fn eq$Point(a%0: ref (Point), b%1: ref (Point)) -> i32 (Bool) {
  x%2: i32 (Int) = field a%0 Point.Point.x#0
  y%3: i32 (Int) = field b%1 Point.Point.x#0
  eq%4: i32 (Bool) = x%2 ==[i32] y%3
  if eq%4 {} else {
    return false
  }
  x%5: i32 (Int) = field a%0 Point.Point.y#1
  y%6: i32 (Int) = field b%1 Point.Point.y#1
  eq%7: i32 (Bool) = x%5 ==[i32] y%6
  if eq%7 {} else {
    return false
  }
  return true
}

fn show$Point(x%0: ref (Point)) -> ref (String) {
  f%1: i32 (Int) = field x%0 Point.Point.x#0
  s%2: ref (String) = builtin Int.to_string(f%1)
  f%3: i32 (Int) = field x%0 Point.Point.y#1
  s%4: ref (String) = builtin Int.to_string(f%3)
  s%5: ref (String) = builtin String.append("Point(x: ", s%2)
  s%6: ref (String) = builtin String.append(s%5, ", y: ")
  s%7: ref (String) = builtin String.append(s%6, s%4)
  s%8: ref (String) = builtin String.append(s%7, ")")
  return s%8
}

fn eq$Tree(a%0: ref (Tree), b%1: ref (Tree)) -> i32 (Bool) {
  ta%2: i32 (Int) = tag a%0
  tb%3: i32 (Int) = tag b%1
  same%4: i32 (Bool) = ta%2 ==[i32] tb%3
  if same%4 {} else {
    return false
  }
  switch tag(a%0) {
    case Tree.Leaf {
      return true
    }
    case Tree.Node {
      x%5: ref (Tree) = field a%0 Tree.Node#0
      y%6: ref (Tree) = field b%1 Tree.Node#0
      eq%7: i32 (Bool) = call eq$Tree(x%5, y%6)
      if eq%7 {} else {
        return false
      }
      x%8: ref (Point) = field a%0 Tree.Node#1
      y%9: ref (Point) = field b%1 Tree.Node#1
      eq%10: i32 (Bool) = call eq$Point(x%8, y%9)
      if eq%10 {} else {
        return false
      }
      x%11: ref (Tree) = field a%0 Tree.Node#2
      y%12: ref (Tree) = field b%1 Tree.Node#2
      eq%13: i32 (Bool) = call eq$Tree(x%11, y%12)
      if eq%13 {} else {
        return false
      }
      return true
    }
  }
  unreachable
}

fn eq$(Int, String)(a%0: ref ((Int, String)), b%1: ref ((Int, String))) -> i32 (Bool) {
  x%2: i32 (Int) = tuple_get a%0#0
  y%3: i32 (Int) = tuple_get b%1#0
  eq%4: i32 (Bool) = x%2 ==[i32] y%3
  if eq%4 {} else {
    return false
  }
  x%5: ref (String) = tuple_get a%0#1
  y%6: ref (String) = tuple_get b%1#1
  eq%7: i32 (Bool) = x%5 ==[string] y%6
  if eq%7 {} else {
    return false
  }
  return true
}
