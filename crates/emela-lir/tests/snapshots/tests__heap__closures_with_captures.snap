export fn main() -> ref (List[Int]) defects {
  f%0: ref (fn(Int) -> fn(Int) -> Int ev ev) = call adder(1)
  t%1: ref (evidence) = ev_extend([])
  g%2: ref (fn(Int) -> Int ev) = call_indirect f%0(2, t%1) on_defect {
    drop f%0
    unwind
  }
  drop f%0
  t%3: ref (evidence) = ev_extend([])
  _%4: i32 (Int) = call_indirect g%2(3, t%3) on_defect {
    drop g%2
    unwind
  }
  drop g%2
  s%5: ref (String) = builtin Int.to_string(_%4)
  runtime debug_print(s%5)
  drop s%5
  t%6: ref (fn(Int) -> Int ev) = make_closure inc$ev$fn[]
  _%7: i32 (Int) = call twice[{}, {}](t%6, 1) on_defect { unwind }
  s%8: ref (String) = builtin Int.to_string(_%7)
  runtime debug_print(s%8)
  drop s%8
  t%9: ref (List[Int]) = list[1, 2]
  f%10: ref (fn(Int) -> Int ev) = make_closure main$closure0[]
  t%11: ref (List[Int]) = call List.map[Int, Int, {}, {}](t%9, f%10) on_defect { unwind }
  dup t%11
  s%12: ref (String) = call show$List[Int](t%11)
  runtime debug_print(s%12)
  drop s%12
  return t%11
}

fn adder(base%0: i32 (Int)) -> ref (fn(Int) -> fn(Int) -> Int ev ev) {
  f%1: ref (fn(Int) -> fn(Int) -> Int ev ev) = make_closure adder$closure0[base%0]
  return f%1
}

fn inc(x%0: i32 (Int)) -> i32 (Int) {
  t%1: i32 (Int) = x%0 +[i32] 1
  return t%1
}

fn inc$ev(x%0: i32 (Int), ev%1: ref (evidence)) -> i32 (Int) {
  drop ev%1
  t%2: i32 (Int) = call inc(x%0)
  return t%2
}

fn inc$ev$fn(env%0: ref (fn(Int) -> Int ev), x%1: i32 (Int), ev%2: ref (evidence)) -> i32 (Int) env[] {
  r%3: i32 (Int) = call inc$ev(x%1, ev%2)
  return r%3
}

fn main$closure0(env%0: ref (fn(Int) -> Int ev), x%1: i32 (Int), ev%2: ref (evidence)) -> i32 (Int) env[] {
  drop ev%2
  t%3: i32 (Int) = x%1 *[i32] 10
  return t%3
}

fn adder$closure0(env%0: ref (fn(Int) -> fn(Int) -> Int ev ev), x%1: i32 (Int), ev%2: ref (evidence)) -> ref (fn(Int) -> Int ev) env[Int] {
  drop ev%2
  base%3: i32 (Int) = env_get env%0#0
  y%4: i32 (Int) = x%1 *[i32] 2
  f%5: ref (fn(Int) -> Int ev) = make_closure adder$closure0$closure0[base%3, y%4]
  return f%5
}

fn adder$closure0$closure0(env%0: ref (fn(Int) -> Int ev), z%1: i32 (Int), ev%2: ref (evidence)) -> i32 (Int) env[Int, Int] {
  drop ev%2
  base%3: i32 (Int) = env_get env%0#0
  y%4: i32 (Int) = env_get env%0#1
  t%5: i32 (Int) = base%3 +[i32] y%4
  t%6: i32 (Int) = t%5 +[i32] z%1
  return t%6
}
