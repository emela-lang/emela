fn work(k%0: i32 (Int), ev%1: ref (evidence)) -> i32 (Int) fails defects {
  t%2: i32 (Bool) = k%0 ==[i32] 0
  if t%2 {
    t%3: ref (Empty) = make Empty.Empty
