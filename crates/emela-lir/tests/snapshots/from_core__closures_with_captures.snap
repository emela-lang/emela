export fn main() -> i32 (Int) {
  f%0: ref (fn(Int) -> fn(Int) -> Int) = call adder(1)
  g%1: ref (fn(Int) -> Int) = call_indirect f%0(2)
  t%2: i32 (Int) = call_indirect g%1(3)
  s%3: ref (String) = builtin Int.to_string(t%2)
  runtime debug_print(s%3)
  return t%2
}

fn adder(base%0: i32 (Int)) -> ref (fn(Int) -> fn(Int) -> Int) {
  f%7: ref (fn(Int) -> fn(Int) -> Int) = closure(x%1: i32 (Int)) [base%0] {
    y%2: i32 (Int) = x%1 *[i32] 2
    f%6: ref (fn(Int) -> Int) = closure(z%3: i32 (Int)) [base%0, y%2] {
      t%4: i32 (Int) = base%0 +[i32] y%2
      t%5: i32 (Int) = t%4 +[i32] z%3
      return t%5
    }
    return f%6
  }
  return f%7
}
