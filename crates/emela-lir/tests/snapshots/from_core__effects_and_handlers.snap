---
source: crates/emela-lir/tests/from_core.rs
expression: "parts(&m, &[\"main\", \"report\", \"Quiet\"])"
---
export fn main() -> i32 (Int) {
  h%0: ref (handler Log) = call Quiet()
  ev%1: ref (evidence) = ev_extend([Log: h%0])
  t%2: i32 (Int) = call report(1, ev%1)
  s%3: ref (String) = builtin Int.to_string(t%2)
  runtime debug_print(s%3)
  return t%2
}

fn Quiet() -> ref (handler Log) {
  f%1: ref (fn(String) -> ()) = closure(msg%0: ref (String)) [] {
    return
  }
  f%2: ref (fn() -> Int) = closure() [] {
    return 0
  }
  t%3: ref (handler Log) = handler Quiet: Log { info: f%1, count: f%2 }
  return t%3
}

fn report(x%0: i32 (Int), ev%1: ref (evidence)) -> i32 (Int) {
  log%2: ref (handler Log) = ev_lookup(ev%1, Log)
  call_op log%2.Log#info("x")
  t%3: i32 (Int) = call_op log%2.Log#count()
  t%4: i32 (Int) = x%0 +[i32] t%3
  return t%4
}
