import Std.Task.{Task}
import Std.Deferred.{Deferred}

@external(js, "console.log")
@external(c, "./print.c", "emela_test_print")
fn print(s: String) -> () uses {}

effect Tick {
  suspend fn tick() -> ()
}

handler Ticks: Tick {
  suspend fn tick(resume) { resume(()) }
}

## A suspending function that does not suspend: calls of it count for fairness too.
fn step(n: Int) -> Int uses { Tick } { n + 1 }

## Counts to `n` with suspending calls, printing every `every` calls. Tasks that never wait still
## take turns: each yields every so many suspending calls (`[task.basic]`), and the order is the same
## on every target.
fn count(name: String, i: Int, n: Int, every: Int) -> Int uses { Tick } {
  if i == n { i } else {
    if i % every == 0 { print("#{name} #{i}") } else { () }
    j = if i % 2 == 0 {
      (use Tick).tick()
      i + 1
    } else {
      step(i)
    }
    count(name, j, n, every)
  }
}

fn main() -> () uses { Async } {
  with Ticks {
    total = with d = Deferred {
      with tasks = Task.Group {
        a = tasks.start(|| count("a", 0, 40000, 2500))
        b = tasks.start(|| count("b", 0, 30000, 2500))
        c = tasks.start(|| count("c", 0, 5000, 1000))
        tasks.start(|| {
          count("d", 0, 20000, 5000)
          d.complete("done")
        })
        print("body #{d.await()}")
        a.join() + b.join() + c.join()
      }
    }
    print("total #{total}")
    print("deep #{count("deep", 0, 300000, 100000)}")
  }
}
