import Std.Task.{Task}
import Std.Deferred.{Deferred}

@external(js, "console.log")
@external(c, "./print.c", "emela_test_print")
fn print(s: String) -> () uses {}

effect Tick {
  suspend fn tick() -> ()
}

handler Ticks: Tick {
  suspend fn tick(resume) { resume(()) }
}

fn spin(n: Int) -> () uses { Tick } {
  if n == 0 { () } else {
    (use Tick).tick()
    spin(n - 1)
  }
}

effect Name {
  fn name() -> String
}

handler Res(label: String): Name {
  init {
    print("init res")
    Self(label: "res")
  }
  fn name() { self.label }
  release { print("release #{self.label}") }
}

## A release that suspends: not interrupted while it runs (spec 11.4).
handler SlowRes: Name {
  init {
    print("init slow")
    Self
  }
  fn name() { "slow" }
  release {
    spin(3000)
    print("release slow")
  }
}

## Nothing resumes the continuations waiting for the Deferred: when the run stalls, every fiber
## unwinds as interrupted and runs its releases from the inside (spec 14.5).
fn main() -> () uses { Async } {
  with Ticks, Res {
    with d = Deferred[()] {
      with tasks = Task.Group {
        tasks.start(|| {
          with SlowRes {
            d.await()
            print("never")
          }
        })
        tasks.start(|| {
          with Res {
            spin(2000)
            print("child waits")
            d.await()
          }
        })
        print("body waits")
        d.await()
        print("never either")
      }
    }
  }
}
