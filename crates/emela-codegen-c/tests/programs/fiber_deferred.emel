import Std.Fiber.{Fiber, Scope}
import Std.Exit.{Exit, Success, Failure}
import Std.Cause.{Cause}
import Std.Deferred.{Deferred}

@external(js, "console.log")
@external(c, "./print.c", "emela_test_print")
fn print(s: String) -> () uses {}

error Boom

effect Tick {
  suspend fn tick() -> ()
}

handler Ticks: Tick {
  suspend fn tick(resume) { resume(()) }
}

fn spin(n: Int) -> () uses { Tick } {
  if n == 0 { () } else {
    (use Tick).tick()
    spin(n - 1)
  }
}

fn fetch(n: Int, ticks: Int) -> Int uses { Tick } {
  spin(ticks * 100)
  print("fetched #{n}")
  n * 10
}

fn boom() -> Int fails Boom { fail Boom }

fn show[A, E](e: Exit[A, E]) -> String {
  e match {
    Success(_) -> "Success"
    Failure(c) -> Cause.to_string(c)
  }
}

fn main() -> () uses { Async } {
  with Ticks {
    Fiber.scope(|| {
      d = Fiber.deferred()
      a = Fiber.fork(|| Deferred.await(d) + 1)
      b = Fiber.fork(|| Deferred.await(d) + 2)
      Fiber.fork(|| {
        spin(1000)
        Deferred.complete(d, 40)
      })
      print("poll #{Deferred.poll(d)}")
      print("joined #{Fiber.join(a)} #{Fiber.join(b)}")
      print("again #{Deferred.complete(d, 1)} #{Deferred.poll(d)}")
      names = Fiber.deferred()
      Fiber.fork(|| Deferred.complete(names, ["x", "y"]))
      print("list #{Deferred.await(names)}")
      done = Fiber.deferred()
      Fiber.fork(|| Deferred.complete(done, ()))
      Deferred.await(done)
      print("unit #{Deferred.poll(done)}")
    })
    xs = Fiber.all([|| fetch(1, 60), || fetch(2, 10)])
    print("all #{xs}")
    w = Fiber.race([|| fetch(3, 200), || fetch(4, 10)])
    print("race #{w}")
    (p, q) = Fiber.both(|| fetch(5, 10), || "x")
    print("both #{p} #{q}")
    ys = Fiber.map([1, 2, 3], |i| fetch(i, 130 - i * 40))
    print("map #{ys}")
    r = Fiber.race([|| boom(), || fetch(8, 1000)]) escape { Boom -> -1 }
    print("race failed #{r}")
    join_later = Fiber.scope(|| {
      h = Fiber.fork(|| 1)
      || Fiber.join(h)
    })
    print(show(Exit.attempt(|| join_later())))
    complete_later = Fiber.scope(|| {
      d = Fiber.deferred()
      || Deferred.complete(d, 1)
    })
    print(show(Exit.attempt(|| complete_later())))
    poll_later = Fiber.scope(|| {
      d = Fiber.deferred()
      || Deferred.poll(d)
    })
    poll_later()
    ()
  }
}
