import Std.Task.{Task}

@external(js, "console.log")
@external(c, "./print.c", "emela_test_print")
fn print(s: String) -> () uses {}

error Empty

effect Tick {
  suspend fn tick() -> ()
}

handler Ticks: Tick {
  suspend fn tick(resume) { resume(()) }
}

fn spin(n: Int) -> () uses { Tick } {
  if n == 0 {
    ()
  } else {
    (use Tick).tick()
    spin(n - 1)
  }
}

fn fail_late() -> String fails Empty uses { Tick } {
  spin(100000)
  fail Empty
}

## An interruption is not an error, so an arm `_` does not handle it (`[error.escape]`,
## `[task.cause]`).
fn main() -> () uses { Async } {
  with Ticks {
    with tasks = Task.Group {
      with stop = Task.Group {
        stop.start(|| print(fail_late() escape { _ -> "caught" }))
        spin(1000)
      }
      print("interrupted")
    }
  }
}
