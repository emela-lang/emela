Record(name: "TodoView", fields: [Field(name: "id", shape: String), Field(name: "dueAt", shape: Option(String)), Field(name: "done", shape: Bool)])
Variants(name: "Tree[String]", variants: [Variant(name: "Leaf", contents: NoFields), Variant(name: "Node", contents: NamedFields([Field(name: "left", shape: Ref("Tree[String]")), Field(name: "value", shape: String), Field(name: "right", shape: Ref("Tree[String]"))])), Variant(name: "pair", contents: PositionalFields([String, String]))])
Record(name: "Team", fields: [Field(name: "name", shape: String), Field(name: "lead", shape: Option(Record(name: "Member", fields: [Field(name: "name", shape: String), Field(name: "team", shape: Option(Ref("Team")))])))])
Record(name: "Page[Member]", fields: [Field(name: "items", shape: List(Record(name: "Member", fields: [Field(name: "name", shape: String), Field(name: "team", shape: Option(Record(name: "Team", fields: [Field(name: "name", shape: String), Field(name: "lead", shape: Option(Ref("Member")))])))]))), Field(name: "next", shape: Option(Int))])
Record(name: "Email", fields: [Field(name: "value", shape: String)])
