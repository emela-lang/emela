# Handler members of a handler with type parameters (`[effect.handler]`): an inner handler has
# the type parameters of its outer handler, and each copy of the outer handler opens the copies of
# its inner handlers for the same type arguments.

effect Cell[T] {
  fn get() -> T
}

effect Log[T] {
  fn put(x: T) -> ()
}

effect Store[T] {
  handler Open(v: T): Cell[T]
  handler Logger(): Log[T]
}

handler Mem[T]: Store[T] {
  handler Open(v: T): Cell[T] {
    init(v: T) {
      _ = dbg(v)
      Self(v:)
    }

    release { _ = dbg(self.v) }

    fn get() { self.v }
  }

  handler Logger(): Log[T] {
    fn put(x) { _ = dbg(x) }
  }
}

fn main() {
  with Mem[Int] {
    with c = Store.Open(1), l = Store.Logger() { l.put(c.get() + 1) }
  }
  with s = Mem[String] {
    with c = s.Open("a"), l = s.Logger() { l.put("#{c.get()}b") }
  }
}
