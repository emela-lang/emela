import Std.Fiber.{Fiber, Scope}

@external(js, "console.log")
@external(c, "./print.c", "emela_test_print")
fn print(s: String) -> () uses {}

error Boom

effect Tick {
  suspend fn tick() -> ()
}

handler Ticks: Tick {
  suspend fn tick(resume) { resume(()) }
}

effect Name {
  fn name() -> String
}

handler Res: Name {
  init { Res }
  fn name() { "res" }
  release { panic("in release") }
}

fn spin(n: Int) -> () uses { Tick } {
  if n == 0 { () } else {
    (use Tick).tick()
    spin(n - 1)
  }
}

fn main() -> () fails Boom uses { Async } {
  with Ticks {
    Fiber.scope(|| {
      Fiber.fork(|| {
        spin(1000)
        fail Boom
      })
      Fiber.fork(|| with Res { spin(100000) })
      print("body")
      spin(100000)
    })
  }
}
