import Std.Task.{Task}
import Std.Exit.{Exit, Success, Failure}
import Std.Cause.{Cause}
import Std.Deferred.{Deferred}

@external(js, "console.log")
@external(c, "./print.c", "emela_test_print")
fn print(s: String) -> () uses {}

effect Tick {
  suspend fn tick() -> ()
}

handler Ticks: Tick {
  suspend fn tick(resume) { resume(()) }
}

fn spin(n: Int) -> () uses { Tick } {
  if n == 0 { () } else {
    (use Tick).tick()
    spin(n - 1)
  }
}

effect Name {
  fn name() -> String
}

## A release that suspends: an interruption waits until it ends (`[task.interrupt]`).
handler SlowRes: Name {
  init {
    print("init slow")
    SlowRes
  }
  fn name() { "slow" }
  release {
    print("release slow starts")
    spin(5000)
    print("release slow ends")
  }
}

## A release that fails while its task unwinds by an interruption.
handler BadRes: Name {
  init { BadRes }
  fn name() { "bad" }
  release { panic("release failed") }
}

effect Slow {
  suspend fn slow(n: Int) -> Int
}

## Suspends before it resumes. If the caller is interrupted meanwhile, the implementation is
## unwound too (spec 12.2, the JS runtime's `onDrop`).
handler Slowly: Slow {
  suspend fn slow(n, resume) {
    with SlowRes {
      spin(n)
      print("impl resumes #{n}")
      resume(n)
    }
  }
}

fn show[A, E](e: Exit[A, E]) -> String {
  e match {
    Success(_) -> "Success"
    Failure(c) -> Cause.to_string(c)
  }
}

## Recursion that suspends at the bottom: the frames are resumed one by one by the driver loop.
fn deep(n: Int) -> Int uses { Tick } {
  if n == 0 {
    spin(2000)
    0
  } else {
    deep(n - 1) + 1
  }
}

fn main() -> () uses { Async } {
  with Ticks {
    # Ending the with of a group interrupts its tasks; the release waits for their releases.
    with tasks = Task.Group {
      tasks.start(|| {
        with SlowRes {
          spin(100000)
        }
      })
      spin(1500)
      print("interrupting")
    }
    print("interrupted")
    bad = Exit.attempt(|| {
      with tasks = Task.Group {
        tasks.start(|| {
          Exit.attempt(|| {
            with BadRes {
              spin(100000)
            }
          }) match {
            Success(_) -> print("attempt success")
            Failure(c) -> print("attempt caught #{Cause.to_string(c)}")
          }
        })
        spin(1500)
        print("body ends")
      }
    })
    print("bad #{show(bad)}")
    with Slowly {
      with tasks = Task.Group {
        with stop = Task.Group {
          stop.start(|| (use Slow).slow(100000))
          spin(1500)
        }
        print("slow interrupted")
        k = tasks.start(|| (use Slow).slow(1000))
        print("slow joined #{k.join()}")
      }
    }
    print("deep #{deep(300)}")
  }
}
