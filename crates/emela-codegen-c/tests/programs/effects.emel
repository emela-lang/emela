import Std.State.{State}

@external(js, "console.log")
@external(c, "./print.c", "emela_test_print")
fn print(s: String) -> () uses {}

effect Log {
  fn log(msg: String) -> ()
}

effect Store {
  fn get(key: String) -> String
}

handler PrintLog: Log {
  fn log(msg) { print("log: #{msg}") }
}

handler Prefixed(prefix: String): Store {
  init {
    (use Log).log("open")
    Prefixed(prefix: "p")
  }

  release {
    (use Log).log("close #{self.prefix}")
  }

  fn get(key) { "#{self.prefix}/#{key}" }
}

handler Counter(start: Int): Store {
  init { Counter(start: 10) }
  fn get(key) { "#{key}=#{self.start}" }
}

fn lookup(keys: List[String]) -> List[String] {
  store = use Store
  List.map(keys, |k| store.get(k))
}

fn count(n: Int) -> Int {
  st = use State[Int]
  if n == 0 {
    st.get()
  } else {
    st.update(|x| x + n)
    count(n - 1)
  }
}

fn main() {
  with PrintLog, Prefixed {
    print("#{lookup(["a", "b"])}")
    with Counter {
      print("#{lookup(["c"])}")
    }
    print((use Store).get("d"))
  }
  (total, final) = State.run(0, || count(100))
  print("#{total} #{final}")
  (lines, kept) = State.run(["start"], || {
    st = use State[List[String]]
    st.set(List.append(st.get(), ["more"]))
    st.update(|xs| [List.length(xs) |> Int.to_string, ..xs])
    st.get()
  })
  print("#{lines} #{kept}")
  adders = List.map([1, 2, 3], |n| |x| x + n)
  print("#{List.map(adders, |f| f(10))}")
  compose = |f, g| |x| g(f(x))
  twice = compose(|x| x * 2, |x| "#{x}!")
  print(twice(21))
}
