fn main() {
  assert Ord.compare((-2147483647 - 1), 2147483647) == Less
  assert Ord.compare(2, 1) == Greater
  assert Ord.compare(1, 1) == Equal
  assert Int.min(-2, 3) == -2
  assert Int.max(-2, 3) == 3
  assert Int.abs(-3) == 3
  assert Int.abs(0) == 0
  assert Int.abs((-2147483647 - 1)) == (-2147483647 - 1)
  nan = 0.0 / 0.0
  inf = 1.0 / 0.0
  assert Float.is_nan(nan)
  assert !Float.is_nan(inf)
  assert !Float.is_nan(-0.0)
  assert Float.compare(nan, nan) == Equal
  assert Float.compare(nan, inf) == Greater
  assert Float.compare(inf, nan) == Less
  assert Float.compare(-inf, inf) == Less
  assert Float.compare(2.0, 1.0) == Greater
  assert Float.compare(0.0, -0.0) == Equal
  assert Float.is_nan(Float.max(nan, 1.0))
  assert Float.is_nan(Float.max(1.0, nan))
  assert Float.min(nan, 1.0) == 1.0
  assert Float.min(1.0, nan) == 1.0
  assert Float.abs(-2.0) == 2.0
  assert Float.abs(-inf) == inf
  assert Float.is_nan(Float.abs(nan))
  assert 1.0 / Float.abs(-0.0) == inf
  assert 1.0 / Float.abs(0.0) == inf
  assert 1.0 / Float.min(-0.0, 0.0) == -inf
  assert 1.0 / Float.max(0.0, -0.0) == inf
}
