# Loop expressions (`[fn.loop]`): initial values, calls to the name with positional and named
# arguments, a deep loop, errors and effects of the body, and a body that suspends.

@external(js, "console.log")
@external(c, "./print.c", "emela_test_print")
fn print(s: String) -> () uses {}

error Boom(at: Int)

effect Name {
  fn name() -> String
}

handler Alice: Name {
  fn name() { "alice" }
}

effect Tick {
  suspend fn tick() -> ()
}

handler Ticks: Tick {
  suspend fn tick(resume) { resume(()) }
}

type Point(x: Int, y: Int)

pub fn range(from: Int, to: Int) -> List[Int] {
  loop onto(to:, acc: []) {
    if to <= from { acc } else { onto(to - 1, [to - 1, ..acc]) }
  }
}

fn noisy(label: String, n: Int) -> Int {
  print("init #{label}")
  n
}

fn order(a: Int) -> Int {
  # The initial values are evaluated left to right, outside the loop: the `a` of `b: a` is the
  # parameter of `order`.
  loop go(a: noisy("a", 1), b: noisy("b", a)) { a * 10 + b }
}

fn count(limit: Int) -> Int {
  loop go(n: 0) {
    if n == limit { n } else { go(n + 1) }
  }
}

fn named(n: Int) -> Int {
  loop go(i: n, acc: 0) {
    if i == 0 { acc } else { go(acc: acc + i, i: i - 1) }
  }
}

fn piped(n: Int) -> Int {
  loop go(i: n) {
    if i <= 0 { i } else { i - 1 |> go }
  }
}

fn walk(p: Point, steps: Int) -> Point {
  loop go(q: p, n: steps) {
    if n == 0 { q } else { go(Point(x: q.x + 1, y: q.y * 2), n - 1) }
  }
}

fn first_negative(xs: List[Int]) -> Int fails Boom {
  loop go(ys: xs, i: 0) {
    ys match {
      [] -> i
      [y, ..rest] -> if y < 0 { fail Boom(at: i) } else { go(rest, i + 1) }
    }
  }
}

fn greet(times: Int) -> String {
  # The `with` around the loop provides the handlers of its body.
  with Alice {
    loop go(n: times, acc: "") {
      name <- Name
      if n == 0 { acc } else { go(n - 1, "#{acc}#{name.name()}") }
    }
  }
}

fn spin(n: Int) -> Int uses { Tick } {
  # The body suspends; the calls to the name still do not consume stack.
  loop go(i: n) {
    if i == 0 { i } else {
      tick <- Tick
      tick.tick()
      go(i - 1)
    }
  }
}

fn nested(n: Int) -> Int {
  loop outer(i: n, total: 0) {
    if i == 0 { total } else {
      row = loop inner(j: i, acc: 0) {
        if j == 0 { acc } else { inner(j - 1, acc + j) }
      }
      outer(i - 1, total + row)
    }
  }
}

fn main() {
  print("#{range(1, 5)}")
  print("#{order(7)}")
  print("#{count(1000000)} #{named(4)} #{piped(5)}")
  p = walk(Point(x: 0, y: 1), 3)
  print("#{p.x} #{p.y}")
  print("#{first_negative([1, 2, 3]) escape { Boom(at:) -> 0 - at }}")
  print("#{first_negative([1, -2, 3]) escape { Boom(at:) -> 0 - at }}")
  print(greet(2))
  print("#{with Ticks { spin(100000) }}")
  print("#{nested(4)}")
}
