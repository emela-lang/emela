import Std.Process.{EXIT_SUCCESS, ExitCode}

@external(js, "console.log")
@external(c, "./print.c", "emela_test_print")
fn print(s: String) -> () uses {}

error UsageError(message: String)

fn run(args: List[String]) -> ExitCode fails UsageError {
  if args == [] { fail UsageError(message: "no file") } else { EXIT_SUCCESS }
}

# `[dyn.error]`: an error turned into an `ExitCode` with escape chooses the exit code.
fn main() -> ExitCode {
  run([]) escape {
    UsageError(message:) -> {
      print("usage: tool <file>: #{message}")
      Process.exit_code(2)
    }
  }
}
