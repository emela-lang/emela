# Side effects go through effects. `Console` is declared in the bundled core,
# and `JsConsole` provides it when the program runs on JavaScript.

# `greet` uses Console, so its caller has to provide one with `with`.
fn greet(name: String) {
  (use Console).print_line("Hello, #{name}!")
}

fn main() {
  with JsConsole {
    (use Console).print_line("hi")
    List.map(["Emela", "world"], greet)
    (use Console).print_error_line("done")
  }
}
