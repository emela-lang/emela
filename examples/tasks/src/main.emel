# Tasks (`[task]`). A task starts only through the capability of a with item that bounds its
# lifetime: `Task.Group` for tasks whose results are awaited, and `Task.Background` for tasks whose
# results are not. The combinators `Task.both`, `Task.map`, `Task.all`, `Task.race` and
# `Task.timeout` are built on `Task.Group`.

import Std.Console.{Console, SystemConsole}
import Std.Clock.{Clock, SystemClock}
import Std.Cause.{Cause}
import Std.Task.{Task}
import Std.Instant.{Instant}

error NotFound(id: Int)

fn fetch(id: Int, ms: Int) -> String fails NotFound uses { Clock, Console } {
  clock <- Clock
  console <- Console
  clock.sleep(ms)
  console.print_line("fetched #{id}")
  if id < 0 { fail NotFound(id:) } else { "user #{id}" }
}

fn main() {
  with SystemConsole, SystemClock {
    console <- Console
    # The waits overlap: the second fetch ends first.
    (a, b) = Task.both(|| fetch(1, 200), || fetch(2, 100))
    console.print_line("both: #{a}, #{b}")
    names = Task.map([3, 4, 5], |id| fetch(id, 100 * (6 - id)))
    console.print_line("map: #{names}")
    first = Task.race([|| fetch(6, 300), || fetch(7, 100)])
    console.print_line("race: #{first}")
    late = Task.timeout(100, || fetch(8, 1000))
    console.print_line("timeout: #{late}")
    # A failing task interrupts its siblings, and the error reaches the with.
    failed = with tasks = Task.Group {
      ok = tasks.start(|| fetch(9, 1000))
      bad = tasks.start(|| fetch(-1, 100))
      "#{ok.join()} #{bad.join()}"
    } escape {
      NotFound(id:) -> "not found: #{id}"
    }
    console.print_line(failed)
    # Tasks of a background are waited for, not interrupted, and their failures go to
    # `on_failure`.
    with bg = Task.Background(on_failure: |cause| console.print_line(Cause.to_string(cause))) {
      bg.start(|| {
        _ = fetch(-2, 100)
        ()
      })
      console.print_line("background started")
    }
  }
}

# Resumes on the spot, so tests do not wait.
handler InstantClock: Clock {
  suspend fn sleep(ms, resume) { resume(()) }
  fn now() { Instant.from_unix_milliseconds(0) }
}

@test
fn map_keeps_the_order() {
  with SystemConsole, InstantClock {
    assert Task.map([1, 2], |id| fetch(id, 0)) == ["user 1", "user 2"]
  }
}
