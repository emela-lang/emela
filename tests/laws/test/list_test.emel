import Brix.Pbt.Gen
import Brix.Pbt.Property

@test
fn reverse_and_map() {
  Property.check(Gen.list(Gen.int()), fn(xs) {
    assert List.reverse(List.reverse(xs)) == xs
    assert List.map(xs, fn(x) { x }) == xs
    assert List.length(List.reverse(xs)) == List.length(xs)
    assert List.append(xs, []) == xs
    assert List.append([], xs) == xs
  })
}

@test
fn append() {
  Property.check(Gen.pair(Gen.list(Gen.int()), Gen.list(Gen.int())), fn(pair) {
    (xs, ys) = pair
    assert List.length(List.append(xs, ys)) == List.length(xs) + List.length(ys)
    assert List.reverse(List.append(xs, ys)) == List.append(List.reverse(ys), List.reverse(xs))
  })
}
