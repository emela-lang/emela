import Brix.Pbt.Gen
import Brix.Pbt.Property

@test
fn reverse_and_map() {
  Property.check(Gen.list(Gen.int()), |xs| {
    assert List.reverse(List.reverse(xs)) == xs
    assert List.map(xs, |x| x) == xs
    assert List.length(List.reverse(xs)) == List.length(xs)
    assert List.append(xs, []) == xs
    assert List.append([], xs) == xs
  })
}

@test
fn append() {
  Property.check(Gen.pair(Gen.list(Gen.int()), Gen.list(Gen.int())), |(xs, ys)| {
    assert List.length(List.append(xs, ys)) == List.length(xs) + List.length(ys)
    assert List.reverse(List.append(xs, ys)) == List.append(List.reverse(ys), List.reverse(xs))
  })
}

@test
fn take() {
  Property.check(Gen.pair(Gen.list(Gen.int()), Gen.int()), |(xs, n)| {
    assert List.append(List.take(xs, n), List.drop(xs, n)) == xs
  })
}

@test
fn sort() {
  Property.check(Gen.list(Gen.int()), |xs| {
    sorted = List.sort(xs)
    assert List.sort(sorted) == sorted
    assert List.length(sorted) == List.length(xs)
    assert List.sort(List.reverse(xs)) == sorted
  })
}
