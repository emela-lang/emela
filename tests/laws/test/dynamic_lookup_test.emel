import Std.Map
import Std.Dynamic.{Dynamic, Fields, Items, Text, Null, DecodeError}

fn lookup_or_fail(value: Dynamic, name: String) -> String {
  {
    value.lookup(name).show()
  } escape {
    DecodeError(expected:, ..) -> expected
  }
}

@test
fn reads_a_key() {
  value = Fields(Map.from_list([("name", Text("a"))]))
  assert value.lookup("name") == Some(Text("a"))
}

@test
fn reads_null_as_a_value() {
  value = Fields(Map.from_list([("name", Null)]))
  assert value.lookup("name") == Some(Null)
}

@test
fn reads_a_missing_key_as_none() {
  value = Fields(Map.empty())
  assert value.lookup("name") == None
}

@test
fn fails_on_a_value_that_is_not_fields() {
  assert lookup_or_fail(Items([]), "name") == "fields"
}
